<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_xml_host.xml —— 演示如何"纯 XML 声明 SouiScreen 并自动启动 SOUI"。

  重点就两行自定义属性：
    app:screenId   —— 非零整数，作为 SouiScreen 的唯一标识。
                           推荐用 @integer/screen_id_xxx 引用资源集中管理，
                           避免各 Activity 硬编码冲突。
    app:souiLayout —— SOUI 布局资源字符串，格式 "type:name"。
                           也推荐用 @string/layout_xxx 引用。

  Activity 只需 setContentView(R.layout.activity_xml_host)，其余全链路：
    LayoutInflater → SouiScreen(Context, AttributeSet)
                 → SouiScreen.Init(AttributeSet) 把两个属性写入 mScreenId/mSouiLayout
                 → onAttachedToWindow() post → startSoui(...)
                 → 完成启动。不需要任何启动代码。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.soui.android.SouiScreen
        android:id="@+id/xml_soui_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:screenId="@integer/screen_id_xml_host"
        app:souiLayout="@string/layout_demo" />

</FrameLayout>
