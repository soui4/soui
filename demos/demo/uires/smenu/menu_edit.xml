<?xml version="1.0" encoding="UTF-8"?>
<!--
  编辑菜单(菜单栏「编辑(E)」下拉)— SMenuEx 自绘菜单(menuRoot 格式)
  样式与 menu_file.xml 保持一致(圆角卡片 + 32px 行高 + 微软雅黑 13)。
-->
<menuRoot skin="skin_menu_bg" padding="10,8,10,8"
          itemSkin="skin_menu_item" itemHeight="32" itemPadding="0,0,0,0"
          iconBarWidth="0" textOffset="14" minWidth="150" maxWidth="240"
          sepSkin="skin_menu_sep" arrowSkin="skin_menu_arrow"
          font="face:微软雅黑,size:13" colorText="@color/clr_text" colorBkgnd="@color/clr_card_bg">
  <!-- 复制 -->
  <menuItem name="menu_add_group" id="21">copy</menuItem>
  <!-- 粘贴 -->
  <menuItem name="menu_modify_group" id="22">paste</menuItem>
  <!-- 子菜单:删除(展开后为 hello / soui5) -->
  <menuItem name="menu_del_group" text="submenu">
    <menuItem name="menu_230" id="230">hello</menuItem>
    <menuItem name="menu_231" id="231">soui5</menuItem>
  </menuItem>
  <!-- 分隔线:窗口高 9px,客户区(去 margin 后)剩 1px 为线条;上下留白 4px,左右内缩 12px -->
  <sep size="-2,9" margin="12,4,12,4"/>
  <!-- 清空 -->
  <menuItem name="menu_clear_group" id="24">clear</menuItem>
</menuRoot>
