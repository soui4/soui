<?xml version="1.0" encoding="utf-8"?>
<!-- 坦克大战结束卡片展示:缩放 0.7->1 + 淡入,与遮罩 250ms 淡入同步 -->
<set fillAfter="true" shareInterpolator="true" interpolator="Decelerate">
    <scale duration="250" fromXScale="0.7" toXScale="1.0" fromYScale="0.7" toYScale="1.0" pivotX="50%" pivotY="50%"/>
    <alpha duration="250" fromAlpha="0.0" toAlpha="1.0"/>
</set>
