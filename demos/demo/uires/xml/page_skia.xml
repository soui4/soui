<include>
  <!--
    page_skia.xml - Skia 渲染高级特性演示分区
    filter level 演示不同抗锯齿/过滤等级的头像缩放效果;
    path 页演示 pathView 路径编辑(txt_path_length/pv_test 为代码引用名);
    SpeedMeter 页演示仪表盘控件(speed_ctrl/btn_speed_dec/btn_speed_inc 为代码引用名)。
  -->
  <tabctrl pos="0,0,-0,-0" colorBkgnd="@color/clr_page_bg" colorText="@color/clr_text" colorTextHover="@color/clr_title" colorTextPush="@color/clr_primary" font="face:微软雅黑,size:13" fontPush="bold:1" focusable="0" tabAlign="top" tabSkin="skin_tab_nav_top" tabInterSize="4" tabHeight="36" tabWidth="110" drawFocusRect="0">

    <page title="filter level">
      <tabctrl pos="0,0,-0,-0" colorText="@color/clr_text" colorTextHover="@color/clr_title" colorTextPush="@color/clr_primary" font="face:微软雅黑,size:13" fontPush="bold:1" focusable="0" tabAlign="top" tabSkin="skin_tab_nav_top" tabInterSize="4" tabHeight="36" tabWidth="90" drawFocusRect="0">
        <page title="none">
          <img pos="0,0,-0,-0" skin="skin_avatar_none"/>
        </page>
        <page title="low">
          <img pos="0,0,-0,-0" skin="skin_avatar_low"/>
        </page>
        <page title="medium">
          <img pos="0,0,-0,-0" skin="skin_avatar_medium"/>
        </page>
        <page title="high">
          <img pos="0,0,-0,-0" skin="skin_avatar_high"/>
        </page>
      </tabctrl>
    </page>
    <page title="path" layout="vbox" padding="20,16,20,18">
      <!-- 页头 -->
      <text text="pathView 路径" font="face:微软雅黑,size:22,bold:1" colorText="@color/clr_title"/>
      <text text="左键添加点，右键删除点，实时显示路径长度" extend_top="6" font="face:微软雅黑,size:12" colorText="@color/clr_text"/>
      <!-- 卡片:路径编辑区 -->
      <window size="-2,0" weight="1" skin="skin_card" layout="vbox" padding="14,13,14,15" extend_top="16">
        <window size="-2,14" layout="hbox" gravity="center" interval="8">
          <window size="3,12" skin="skin_card_bar"/>
          <text text="路径长度:" font="face:微软雅黑,size:12,bold:1" colorText="@color/clr_text_sub"/>
          <text size="-1,-1" name="txt_path_length" colorText="@color/clr_primary" font="face:微软雅黑,size:12,bold:1">0</text>
        </window>
        <pathView size="-2,0" weight="1" cornerRadius="8" lineStyle="3" lineWidth="2" lineColor="@color/clr_primary" name="pv_test" extend_top="12">
          演示path
        </pathView>
      </window>
    </page>
    <page title="SpeedMeter" layout="vbox" padding="20,16,20,18">
        <!-- 页头 -->
        <text text="SpeedMeter 仪表盘" font="face:微软雅黑,size:22,bold:1" colorText="@color/clr_title"/>
        <text text="点击 +/- 调整表盘读数，观察指针动画" extend_top="6" font="face:微软雅黑,size:12" colorText="@color/clr_text"/>
        <window size="-2,0" weight="1" skin="skin_card" padding="14,13,14,15" layout="vbox" gravity="center" interval="10" extend_top="16">
          <window size="-1,-1" layout="hbox" gravity="center" interval="10">
            <button name="btn_speed_dec" text="-" size="50,30" skin="skin_btn" font="face:微软雅黑,size:13" colorText="@color/clr_title" drawFocusRect="0"/>
            <button name="btn_speed_inc" text="+" size="50,30" skin="skin_btn" font="face:微软雅黑,size:13" colorText="@color/clr_title" drawFocusRect="0"/>
          </window>
          <SpeedMeter size="200,200" name="speed_ctrl" layout_gravity="center" extend_top="12" value="200" minValue="0" maxValue="300" RingWidth="16" />
        </window>
    </page>
  </tabctrl>
</include>
