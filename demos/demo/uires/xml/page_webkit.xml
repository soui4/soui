<!--
    page_webkit.xml - 内嵌浏览器(教程)演示分区
    fadeframe 实现工具栏"自动隐藏":鼠标移到顶部区域时 webkit_toolbar 渐显,移开后延时渐隐;
    targetName 指向 webkit_toolbar。
    首行 text 是 wkeWebkit 创建失败（缺 wke.dll）时的兜底提示：WM_CREATE 返回非 0 时控件被父窗口销毁，
    铺在它下面的 text 才会露出；wke 正常加载时网页会覆盖这段文字。
    wke_test/edit_url/btn_webkit_back/fore/refresh/go 被 MainDlg_Webkit.cpp 引用,不可改名。
    工具栏背景 skin_webkit_nav_bk 与图标按钮(webbtn_*.svg)均沿用 demo 浅色圆角卡片 + 青色主题。
  -->
  <window size="-2,-2" colorBkgnd="@color/clr_page_bg">
    <text pos="8,8,-8,-8" align="center" valign="center" colorText="@color/clr_text_sub" multiLines="1">没有找到可用的 wke.dll，网页无法加载。\n仓库自带的 wke.dll 仅有 32 位版本；64 位及其他平台请从以下仓库自行编译：\nhttps://gitee.com/setoutsoft/wkex.git\n再把编译产物（wke.dll / libwke.so / libwke.dylib）复制到 demo 运行目录\n（与 demo.exe 同目录），然后重启程序。</text>
    <fadeframe pos="16,16,-16,56" targetName="webkit_toolbar" showAlpha="235">
      <!--自动隐藏:鼠标进入顶部区域时工具栏渐显,移开后延时渐隐-->
    </fadeframe>
    <wkeWebkit pos="8,8,-8,-8" url="https://soui.com.cn" name="wke_test"/>
    <window pos="16,16,-16,56" name="webkit_toolbar" skin="skin_webkit_nav_bk" layeredWindow="1" layout="hbox" gravity="center" padding="8,0,8,0" interval="6">
      <!--这个窗口是前面的 fadeframe 的作用对象;图标按钮用 SVG 三态图标(灰→主色青)。
          工具栏底色是浅灰,中间地址栏是白色药丸(skin_url_box),两者形成"灰条 + 白输入框"的
          浏览器常规结构;四个按钮统一 26x26(原来"转到"是 30x30,比其它三个大一圈)。
          工具栏高度 40(60-16 改为 56-16),不再用 44 的大空白条。-->
      <imgbtn name="btn_webkit_back" skin="skin_webbtn_back" size="26,26" animate="1" tip="后退" drawFocusRect="0"/>
      <imgbtn name="btn_webkit_fore" skin="skin_webbtn_forward" size="26,26" animate="1" tip="前进" drawFocusRect="0"/>
      <imgbtn name="btn_webkit_refresh" skin="skin_webbtn_refresh" size="26,26" animate="1" tip="刷新" drawFocusRect="0"/>
      <edit2 size="0,-2" weight="1" height="28" class="cls_edit" name="edit_url">https://soui.com.cn</edit2>
      <imgbtn name="btn_webkit_go" skin="skin_webbtn_go" size="26,26" animate="1" tip="转到" drawFocusRect="0"/>
    </window>
  </window>
