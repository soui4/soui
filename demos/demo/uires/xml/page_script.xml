<?xml version="1.0" encoding="utf-8"?>
<!--
  page_script.xml - 脚本演示页(跑马机 + 消消乐,lua 版)

  由原 misc 分区的 script 页(跑马机)与原 page_xxl.xml(消消乐)合并而成,
  内层 tabctrl 两个子页切换;两个小游戏的逻辑都在 uires/lua/test.lua:
  - 跑马机: game_wnd/game_canvas/players/flag_win,on_init 时初始化,
    on_run 启动计时器推进赛马,on_bet 下注,on_canvas_size 跟随布局;
  - 消消乐: 参考 soxxl(基于 soui4js 的消消乐)移植并完善为市场常见玩法,
    7x7 棋盘由 lua 的 xxl_init 在宿主初始化时动态创建,
    每个格子是 t.g.xxl_ele 模板实例(values/template.xml,SVG 糖果风棋子),
    stack 的 on_command 属性直接把点击事件路由到 lua 全局函数 xxl_on_cmd;
    交换/消除/下沉动画使用 SValueAnimator(animator:xxl_move) + 动画组,
    回调经 exp_LuaValueAnimator.h 的包装进入 lua;
    wnd_xxl_aniframe 是动画浮层,动画期间把移动中的元素画在棋盘之上;
    金币/得分用 t:g.xxl_digit 七段 LED 翻页计数器(soxxl digit 同款),
    完善点: 连击计分、无步可走自动洗牌、提示、游戏结束弹窗;
    功能按钮("重新开始"/"提示")为 SVG 药丸形底(3 态)+SVG 图标(3 态)
    组合按钮(skin: xxl_btn_primary/xxl_btn_secondary)。
  棋盘/状态栏的名字与 id 约定见 test.lua 的 xxl_* 函数。
-->
<tabctrl pos="0,0,-0,-0" tabWidth="100" tabAlign="left" curSel="0" animateSteps="20"
         colorBkgnd="@color/clr_page_bg" colorText="@color/clr_title">
  <page title="消消乐">
    <window size="full,full" layout="hbox" padding="15,12,15,15" interval="12">
      <!-- 左侧信息卡片:标题 / SVG 功能按钮 / LED 计分区 / 玩法说明 -->
      <window size="192,-2" layout="vbox" interval="10" padding="14,12,14,12" colorBkgnd="@color/clr_card_bg">
        <!-- 标题行:糖果图标 + 标题/副标题 -->
        <window size="-2,-1" layout="hbox" interval="8">
          <img size="30,30" skin="svg_xxl_icons" iconIndex="0" layout_gravity="center" msgTransparent="1"/>
          <window size="-1,-2" layout="vbox" interval="1">
            <text text="消消乐" font="size:16,bold:1" colorText="@color/clr_title"/>
            <text text="LUA + SVG 完整版" font="size:10" colorText="@color/clr_text_sub"/>
          </window>
        </window>
        <hr size="-2,1" mode="horizontal" colorLine="@color/clr_divider"/>
        <!-- 功能按钮:SVG 药丸形底(3 态) + SVG 图标(3 态),重新开始=主色实底,提示=白底描边 -->
        <button name="btn_xxl_restart" size="-2,36" skin="xxl_btn_primary" layout="hbox" cursor="hand" on_command="xxl_on_restart" tip="重新开始一局">
          <window size="0,0" weight="1" msgTransparent="1"/>
          <img size="16,16" skin="svg_xxl_btn_restart" msgTransparent="1"/>
          <text text="重新开始" extend_left="6" font="size:13,bold:1" colorText="#FFFFFF" msgTransparent="1"/>
          <window size="0,0" weight="1" msgTransparent="1"/>
        </button>
        <button name="btn_xxl_hint" size="-2,36" skin="xxl_btn_secondary" layout="hbox" cursor="hand" on_command="xxl_on_hint" tip="提示一步可行走法">
          <window size="0,0" weight="1" msgTransparent="1"/>
          <img size="16,16" skin="svg_xxl_btn_hint" msgTransparent="1"/>
          <text text="提 示" extend_left="6" font="size:13,bold:1" colorText="@color/clr_primary" msgTransparent="1"/>
          <window size="0,0" weight="1" msgTransparent="1"/>
        </button>
        <hr size="-2,1" mode="horizontal" colorLine="@color/clr_divider"/>
        <!-- 计分区:七段 LED 翻页计数器 -->
        <text text="金币" font="size:12" colorText="@color/clr_text_sub"/>
        <window size="-2,-1" layout="hbox" interval="3">
          <t:g.xxl_digit><data name="digit_coin_2"/></t:g.xxl_digit>
          <t:g.xxl_digit><data name="digit_coin_1"/></t:g.xxl_digit>
          <t:g.xxl_digit><data name="digit_coin_0"/></t:g.xxl_digit>
        </window>
        <text text="得分" extend_top="2" font="size:12" colorText="@color/clr_text_sub"/>
        <window size="-2,-1" layout="hbox" interval="3">
          <t:g.xxl_digit><data name="digit_score_2"/></t:g.xxl_digit>
          <t:g.xxl_digit><data name="digit_score_1"/></t:g.xxl_digit>
          <t:g.xxl_digit><data name="digit_score_0"/></t:g.xxl_digit>
        </window>
        <text name="txt_xxl_combo" text="" size="-2,-1" extend_top="4" font="size:13,bold:1" colorText="@color/orange"/>
        <window size="0,0" weight="1"/>
        <hr size="-2,1" mode="horizontal" colorLine="@color/clr_divider"/>
        <text text="交换相邻棋子凑 3 连消除&#10;连击有加分&#10;无路可走自动洗牌" font="size:11" colorText="@color/clr_text_sub" multilines="1"/>
      </window>
      <!-- 棋盘卡片:7x7 gridlayout 棋盘 + 顶层动画浮层(名字/层级为 lua 依赖,不可改动) -->
      <window size="0,-2" weight="1" layout="vbox" padding="12,12,12,12" colorBkgnd="@color/clr_card_bg">
        <stack size="-2,0" weight="1" curSel="-2" colorBkgnd="@color/clr_window_bg">
          <window size="-2,-2" name="wnd_xxl_board" layout="gridlayout" columnCount="7" gravity="fill"/>
          <window size="-2,-2" name="wnd_xxl_aniframe" msgTransparent="1"/>
        </stack>
      </window>
    </window>
  </page>
  <page title="跑马机">
    <window size="full,full" name="game_wnd" id="300">
      <text pos="0,0,-0,@30" colorBkgnd="#cccccc" colorText="#ff0000" align="center">SOUI + LUA 跑马机</text>
      <window pos="0,[0,-0,-50">
        <window pos="0,0,-64,-0" name="game_canvas" on_size="on_canvas_size" clipClient="1" colorBkgnd="#ffffff">
          <!--比赛场地-->
          <gifplayer name="player_1" float="1" skin="gif_horse">
            <text pos="0,%1" colorText="rgb(255,0,0)" font="size:20">1</text>
          </gifplayer>
          <gifplayer name="player_2" float="1" skin="gif_horse">
            <text pos="0,0" colorText="rgb(255,0,0)" font="size:20">2</text>
          </gifplayer>
          <gifplayer name="player_3" float="1" skin="gif_horse">
            <text pos="0,0" colorText="rgb(255,0,0)" font="size:20">3</text>
          </gifplayer>
          <gifplayer name="player_4" float="1" skin="gif_horse">
            <text pos="0,0" colorText="rgb(255,0,0)" font="size:20">4</text>
          </gifplayer>
          <gifplayer name="flag_win" float="1" skin="gif_win" show="0" id="400"/>
          <text pos="|0,0">赔率:</text>
          <text pos="[0,0,@20,[0" colorText="#ff0000" name="txt_rate">4</text>
          <hr pos="-1,0,-0,-0" mode="vertical" colorLine="#ff0000"/>
        </window>
        <window pos="[0,0,-0,-0">
          <window pos="0,%12.5,@64,@64" offset="0,-0.5" skin="img_coin" id="101" tip="下注1号马" on_command="on_bet">0</window>
          <window pos="0,%37.5,@64,@64" offset="0,-0.5" skin="img_coin" id="102" tip="下注2号马" on_command="on_bet">0</window>
          <window pos="0,%62.5,@64,@64" offset="0,-0.5" skin="img_coin" id="103" tip="下注3号马" on_command="on_bet">0</window>
          <window pos="0,%87.5,@64,@64" offset="0,-0.5" skin="img_coin" id="104" tip="下注4号马" on_command="on_bet">0</window>
        </window>
      </window>
      <window pos="10,[5,-0,-0" name="game_toolbar">
        <button name="btn_run" pos="0,|0,@100,@30" offset="0,-0.5" tip="run the game" on_command="on_run">run</button>
        <text pos="]-5,0,@-1,-0" offset="-1,0">现有金币:</text>
        <text pos="-64,0,@64,-0" name="txt_coins" align="center">100</text>
      </window>
    </window>
  </page>
</tabctrl>
