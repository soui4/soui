<SOUI trCtx="dlg_set_skin" title="set skin"  margin="5,5,5,5" resizable="0" translucent="1" appWnd="1" wndType="normal" >
  <style>
    <!--局部style对象-->
    <class name="skin_border" ncSkin="_skin.sys.border" margin-x="1" margin-y="1" />
  </style>
  <skin>
    <!-- 皮肤预览缩略图的边框:1px 浅灰细线(替代内置 _skin.sys.border 的深色描边),
         用法:缩略图节点写 ncSkin="skin_thumb_border" margin="1" -->
    <colorrect name="skin_thumb_border" normalBorder="@color/clr_line" borderWidth="1" cornerRadius="4"/>
    <imglist name="skin_bkimg_0_fit" src="bkimg:skin_pic_0" colorizeEnable="0"/>
    <imglist name="skin_bkimg_1_fit" src="bkimg:skin_pic_1" colorizeEnable="0"/>
    <imglist name="skin_bkimg_2_fit" src="bkimg:skin_pic_2" colorizeEnable="0"/>
    <imglist name="skin_bkimg_3_fit" src="bkimg:skin_pic_3" colorizeEnable="0"/>
    <imglist name="skin_bkimg_4_fit" src="bkimg:skin_pic_4" colorizeEnable="0"/>
    <imglist name="skin_bkimg_5_fit" src="bkimg:skin_pic_5" colorizeEnable="0"/>
    <imglist name="skin_bkimg_6_fit" src="bkimg:skin_pic_6" colorizeEnable="0"/>
    <imglist name="skin_bkimg_7_fit" src="bkimg:skin_pic_7" colorizeEnable="0"/>
    <imglist name="skin_bkimg_8_fit" src="bkimg:skin_pic_8" colorizeEnable="0"/>
    <imglist name="skin_bkimg_9_fit" src="bkimg:skin_pic_9" colorizeEnable="0"/>
    <imglist name="skin_bkimg_10_fit" src="bkimg:skin_pic_10" colorizeEnable="0"/>
    <imglist name="skin_bkimg_11_fit" src="bkimg:skin_pic_11" colorizeEnable="0"/>
    <imglist name="skin_bkimg_12_fit" src="bkimg:skin_pic_12" colorizeEnable="0"/>
    <imglist name="skin_bkimg_13_fit" src="bkimg:skin_pic_13" colorizeEnable="0"/>
    <imglist name="skin_bkimg_14_fit" src="bkimg:skin_pic_14" colorizeEnable="0"/>
    <imglist name="skin_bkimg_15_fit" src="bkimg:skin_pic_15" colorizeEnable="0"/>
    <imglist name="skin_bkimg_16_fit" src="bkimg:skin_pic_16" colorizeEnable="0"/>
    <imglist name="skin_bkimg_17_fit" src="bkimg:skin_pic_17" colorizeEnable="0"/>
  </skin>
  <root colorBkgnd="@color/clr_card_bg" cache="1" width="758" height="500"
        enterAnimation="anim:scale_in"
        exitAnimation="anim:scale_out">
    <window id="9527" pos="1,1,-1,-1" skin="demoskinbk"  cache="1">
      <!-- 标题栏:白底 + 1px 底边细线,标题 14 号深灰字,与主窗口标题条同一语言 -->
      <caption pos="0,0,-0,36" show="1" font="adding:0" layout="hbox" padding="12,0,10,0" gravity="center"
               colorBkgnd="@color/clr_card_bg">
        <icon size="-1,-1" src="ICON_LOGO:16"/>
        <text size="-1,-1" extend_left="8" font="face:微软雅黑,size:14,bold:1" colorText="@color/clr_title">@string/setskintitle</text>
        <window size="0,0" weight="1" visible="0"/>
        <!-- 关闭按钮:28x28 矢量叉(4 态),避免沿用系统位图 _skin.sys.btn.close 在缩放下发虚 -->
        <imgbtn size="28,28" name="btn_close" skin="skin_msgbox_close" animate="1" drawFocusRect="0"/>
      </caption>
      <window pos="0,36,-0,-0" colorBkgnd="@color/clr_window_bg">
        <window pos="0,1,-0,-0" colorBkgnd="@color/clr_card_bg">
          <window pos="4,7,-4,@100">
            <img pos="2,0,@120,@120" ncSkin="skin_thumb_border" margin="1" name="img_skin_0" id="10" msgTransparent="0" skin="skin_bkimg_0_fit"/>
