            <img pos="[3,0,@120,@120" ncSkin="skin_thumb_border" margin="1" name="img_skin_11" id="20" msgTransparent="0" skin="skin_bkimg_10_fit"/>
            <img pos="[4,0,@120,@120" ncSkin="skin_thumb_border" margin="1" name="img_skin_12" id="21" msgTransparent="0" skin="skin_bkimg_11_fit"/>
          </window>
          <window pos="4,[2">
            <img pos="[2,0,@120,@120" ncSkin="skin_thumb_border" margin="1" name="img_skin_13" id="22" msgTransparent="0" skin="skin_bkimg_12_fit"/>
            <img pos="[3,0,@120,@120" ncSkin="skin_thumb_border" margin="1" name="img_skin_14" id="23" msgTransparent="0" skin="skin_bkimg_13_fit"/>
            <img pos="[3,0,@120,@120" ncSkin="skin_thumb_border" margin="1" name="img_skin_15" id="24" msgTransparent="0" skin="skin_bkimg_14_fit"/>
