            <window pos="[1,0,@40,@40" ncSkin="skin_thumb_border" margin="1" colorBkgnd="#6b51c0" colorizeEnable="0" id="36"/>
            <window pos="[1,0,@40,@40" ncSkin="skin_thumb_border" margin="1" colorBkgnd="#595ca0" colorizeEnable="0" id="37"/>
            <window pos="[1,0,@40,@40" ncSkin="skin_thumb_border" margin="1" colorBkgnd="#3074c1" colorizeEnable="0" id="38"/>
            <window pos="[1,0,@40,@40" ncSkin="skin_thumb_border" margin="1" colorBkgnd="#00829a" colorizeEnable="0" id="39"/>
            <window pos="[1,0,@40,@40" ncSkin="skin_thumb_border" margin="1" colorBkgnd="#159c77" colorizeEnable="0" id="40"/>
            <window pos="[1,0,@40,@40" ncSkin="skin_thumb_border" margin="1" colorBkgnd="#4fb0ac" colorizeEnable="0" id="41"/>
