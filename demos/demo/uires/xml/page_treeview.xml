<?xml version="1.0" encoding="utf-8"?>
<!--
  page_treeview.xml - TreeView 控件演示(page_ctrls 的 treeview 子页)

  以"房间列表"为场景演示 STreeView 的模板节点机制:
  template 内 img_state/txt_label/ani_hot/btn_go_offcial_url 的 name
  被 CMainDlg 的树适配器按名引用,不可改动。
-->
<window size="-2,-2" layout="vbox" padding="20,16,20,18">
	<!-- 页头 -->
	<text text="TreeView" font="face:微软雅黑,size:22,bold:1" colorText="@color/clr_title"/>
	<text text="支持节点模板的树形列表,以房间列表为演示场景" extend_top="6" font="face:微软雅黑,size:12" colorText="@color/clr_text"/>

	<!-- 卡片:整块树区 -->
	<window size="-2,0" weight="1" skin="skin_card" layout="vbox" padding="14,13,14,15" extend_top="16">
		<window size="-2,26" layout="hbox" gravity="center" interval="8">
			<window size="3,12" skin="skin_card_bar"/>
			<text text="房间列表" font="face:微软雅黑,size:12,bold:1" colorText="@color/clr_text_sub"/>
			<window size="0,0" weight="1"/>
			<check name="chk_multi_tv" text="多选" checked="1" skin="skin_check" size="60,24"
			       font="face:微软雅黑,size:12" colorText="@color/clr_text" focusable="0" drawFocusRect="0"/>
			<check name="chk_band_tv" text="框选" checked="1" skin="skin_check" size="60,24"
			       font="face:微软雅黑,size:12" colorText="@color/clr_text" focusable="0" drawFocusRect="0"/>
		</window>
		<window size="-2,1" colorBkgnd="@color/clr_line" extend_top="12"/>
		<treeview name="room_tv" multiSel="1" bandEnable="1" size="-2,0" weight="1" margin="1,1"
		          colorBorder="@color/clr_line" hasLines="false" indent="14" extend_top="6" toggleSkin="skin_tree_toggle"
		          colorBkgnd="@color/clr_card_bg" colorItemSelBkgnd="@color/clr_accent_t"
		          sbSkin="skin_scrollbar">
			<!-- 行高 28、缩进 14:原来 32/18 在 125% DPI 下每级缩进约 47px,层级显得格外松散 -->
				<template data="xml:roomlist" height="28" layout="hbox" trackMouseEvent="1" gravity="center" interval="8" padding_left="2" font="face:微软雅黑,size:13">
				<img name="img_state" skin="skin_tree_icon" iconIndex="0" size="16,16"/>
				<text name="txt_label" colorText="@color/clr_text"/>
				<!-- 火苗是 6 帧 PNG 动画,原尺寸偏大,约束到 14px 才与 13px 字体协调 -->
					<animateimg name="ani_hot" skin="skin_hot" display="0" visible="0" size="14,14"/>
				<button  size="42,22" name="btn_go_offcial_url" display="0" visible="0" text="www" skin="skin_btn_ghost"
				         font="face:微软雅黑,size:11" colorText="@color/clr_text" drawFocusRect="0" tip="open platform website"/>
			</template>
		</treeview>
	</window>
</window>
