<SOUI trCtx="dlg_main"
      title="SOUI-DEMO"
      bigIcon="ICON_LOGO:32"
      smallIcon="ICON_LOGO:16"
      width="1000"
      height="700"
      wndType="appMain"
      margin="10,10,10,10"
      resizable="1"
      translucent="1"
      sendWheel2Hover="1"
      alpha="255">
  <user test="0"/>
  <skin>
    <!--局部skin对象-->
    <gif name="gif_penguin" src="gif:gif_penguin"/>
    <apng name="apng_haha" src="apng:apng_haha"/>
  </skin>
  <style>
    <!--局部style对象-->
    <!-- 输入类控件统一外观:skin_edit_nc 圆角描边。用 skin(背景皮肤)而非 ncSkin:
         ncSkin 由 OnNcPaint 绘制时会用 RGN_DIFF 裁掉客户区,只留 1px 外环,圆角弧线落在被裁区域内会缺四个角。
         padding 作用于 richedit 文字内缩 / combobox 子编辑框位置 / listbox 项区 -->
    <class name="cls_edit" skin="skin_edit_nc" ncSkin="skin_edit_nc" margin="0" colorText="@color/clr_title" padding="8,4,8,4"/>
  </style>
  <script src="lua:lua_test">
    <!--当没有指定src属性时从cdata段中加载脚本-->
    <![CDATA[
    function on_init(args)
	    SMessageBox(0,T "execute script function: on_init", T "msgbox", 1);
    end

    function on_exit(args)
	    SMessageBox(0,T "execute script function: on_exit", T "msgbox", 1);
    end

    function onEvtTest2(args)
	    SMessageBox(0,T "onEvtTest2", T "msgbox", 1);
	    return 1;
    end

    function onEvtTstClick(args)
	    local txt3=SStringW(L"append",-1);
	    local sender=toSWindow(args.sender);
	    sender:GetParent():CreateChildrenFromString(L"<button pos=\"0,0,150,30\" on_command=\"onEvtTest2\" drawFocusRect="0">lua btn 中文</button>");
	    sender:SetVisible(0,1);
	    return 1;
    end
    ]]>
  </script>
  <!--
    主窗口布局说明:
      1. id=9527 的 window 是换肤演示的背景载体(demoskinbk),换肤/主题色渲染均作用于它;
      2. nav_bar 为全局导航栏(背景透明,不遮挡换肤层),
         返回按钮与标题文字组合在同一个 button(btn_back)内,点击任意位置均返回宫格首页;
         仅在宫格以外的页面显示;
      3. tab_main 隐藏页签头(tabHeight=0),九宫格首页与 7 个演示分区页均由 tabctrl 承载,
         animateSteps=30(300ms)+Decelerate 插值器提供页面滑动切换动画,
         页面切换统一由宫格卡片和返回按钮驱动(SetCurSel);
  -->
  <root skin="_skin.sys.wnd.bkgnd" cache="1" on_init="on_init" on_exit="on_exit"
        enterAnimation="anim:alpha_in" exitAnimation="anim:alpha_out">
    <!--
      换肤背景载体:默认 demoskinbk 为空(不画图也不画色),此时底下这层 colorBkgnd 会透出来。
      它必须用中性窗口底色(@color/clr_window_bg),不能写死旧版蓝色 #169ada:
      内容页统一是半透明底色,叠在上面会把这层底色透出来,写死蓝色会让"内置皮肤"
      以及任何主题下整个界面都偏蓝,看起来像换肤没生效。
    -->
    <window pos="1,1,-1,-1" id="9527" skin="demoskinbk" cache="1" colorBkgnd="@color/clr_window_bg"/>
    <caption pos="0,0,-0,36" font="adding:1" layout="hbox" gravity="center" padding_left="10" colorBkgnd="#FFFFFF">
      <frame size="-2,-2" layout="hbox" gravity="center">
        <!--show where a frame widget can be used-->
        <icon src="ICON_LOGO:16"/>
        <text name="txt_title" extend_left="5"/>
        <window size="0,0" weight="1" visible="0"/>
        <imgbtn name="btn_skin" skin="svg_btn_skin" size="20,20" animate="0" extend_left="6" drawFocusRect="0"/>
        <imgbtn name="btn_menu" skin="svg_btn_menu" size="20,20" animate="0" extend_left="6" drawFocusRect="0"/>
        <imgbtn id="5" skin="skin_cap" size="30,26" animate="0" extend_left="8" drawFocusRect="0">
          <img skin="svg_win_icons" iconIndex="0" size="18,18" pos="|0,|0" offset="-0.5,-0.5" msgTransparent="1"/>
        </imgbtn>
        <window size="30,26">
          <imgbtn id="2" skin="skin_cap" size="30,26" pos="0,0" animate="0" drawFocusRect="0">
            <img skin="svg_win_icons" iconIndex="1" size="18,18" pos="|0,|0" offset="-0.5,-0.5" msgTransparent="1"/>
          </imgbtn>
          <imgbtn id="3" skin="skin_cap" size="30,26" pos="0,0" show="0" animate="0" drawFocusRect="0">
            <img skin="svg_win_icons" iconIndex="2" size="18,18" pos="|0,|0" offset="-0.5,-0.5" msgTransparent="1"/>
          </imgbtn>
        </window>
        <imgbtn id="1" skin="skin_cap_close" size="30,26" animate="0" drawFocusRect="0"/>
      </frame>
    </caption>

    <tabctrl name="tab_main" pos="0,36,-0,-0" interpolator="Decelerate" curSel="0" focusable="0" animateSteps="30" tabHeight="0" drawFocusRect="0">
      <page title="home">
        <include src="layout:page_home"/>
      </page>
      <page title="contents" layout="vbox" colorBkgnd="@color/clr_window_bg">
        <!--
          全局导航栏:与页面同色的细条(无底边线),左侧为返回钮(箭头 + 分区标题),
          标题文本由 CMainDlg::NavigateToPage 按 tab_contents 当前页 title 设置。
          点击整块返回钮回到宫格首页。
        -->
        <window name="nav_bar" size="-2,32" layout="hbox" gravity="center"
                padding_left="8" padding_right="12" colorBkgnd="@color/clr_window_bg">
          <!-- 尺寸用 "-1,24":-1 = wrapContent,返回钮宽度由"箭头 + 分区标题"撑开;
               之前写成 -2(填满父窗口),按钮被拉伸成整条导航栏,点击热区覆盖全宽,看着很怪 -->
          <button name="btn_back" size="-1,24" layout="hbox" gravity="center" interval="5"
                  padding="4,0,10,0" skin="skin_nav_back_bk" cursor="hand" tip="返回宫格首页" drawFocusRect="0">
            <img skin="svg_btn_back" size="14,14"/>
            <text name="txt_nav_title" font="face:微软雅黑,size:12" colorText="@color/clr_text_sub" msgTransparent="1"/>
          </button>
        </window>
        <tabctrl name="tab_contents" size="-2,0" weight="1" interpolator="Decelerate" curSel="0" focusable="0" animateSteps="30" tabHeight="0" text-y="50" tabSkin="skin_tab_nav_top" iconSkin="skin_page_icons" icon-x="10" colorTextHover="@color/clr_title" drawFocusRect="0">
          <page title="基础控件">
            <include src="layout:page_ctrls"/>
          </page>
          <page title="教程" tip="show webkit based on WKE">
            <include src="layout:page_webkit"/>
          </page>
          <page title="动画" tip="play gif and apng">
            <include src="layout:page_animator"/>
          </page>
          <page title="布局" tip="show layout capability in soui">
            <include src="layout:page_layout"/>
          </page>
          <page title ="杂项" tip="many features, just find it.">
            <include src="layout:page_misc"/>
          </page>
          <page title="Skia" tip="demo skia advance features">
            <include src="layout:page_skia"/>
          </page>
          <page title="脚本" tip="lua 跑马机 / 消消乐 / 俄罗斯方块 / 坦克大战" iconIndex="2">
            <include src="layout:page_script"/>
          </page>
          <page title="关于" tip="copy right(c) setoutsoft 2011-2019.">
            <include src="layout:page_about"/>
          </page>
        </tabctrl>
      </page>
    </tabctrl>
    <shellnotifyicon name="tray_008" icons="ICON_MM_ONLINE;ICON_MM_OFFLINE;ICON_Loading1;ICON_Loading2;ICON_Loading3;ICON_Loading4;ICON_Loading5;ICON_Loading6" startframe="2" duration="200" tip="SOUI小飞侠"/>
  </root>
</SOUI>
