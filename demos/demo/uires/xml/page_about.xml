<?xml version="1.0" encoding="utf-8"?>
<!--
  page_about.xml - 关于页
  统一版式:页头(22 号粗体标题 + 12 号灰说明) + 三张卡片(欢迎与协议 / QQ 群 / 代码仓库)。
  卡片用 skin_card(白底+1px 描边+10px 圆角),页面底 @color/clr_page_bg(半透明,透出换肤背景图)。
  无 name/id 控件被源码引用,链接 href 与 cls_btn_weblink 样式保持不变。
-->
<window layout="vbox" size="-2,-2" padding="20,16,20,18" colorBkgnd="@color/clr_page_bg">
  <!-- 页头 -->
  <text text="关于 SOUI" font="face:微软雅黑,size:22,bold:1" colorText="@color/clr_title"/>
  <text text="开源协议、版权信息与社区资源入口" extend_top="6" font="face:微软雅黑,size:12" colorText="@color/clr_text"/>

  <!-- 卡片:欢迎与协议 -->
  <window size="-2,-1" skin="skin_card" layout="vbox" padding="14,13,14,15" extend_top="16">
    <window size="-1,-1" layout="hbox" gravity="center" interval="16" layout_gravity="center">
      <icon src="ICON_LOGO:64" size="64,64" layout_gravity="center"/>
      <text text="欢迎使用SOUI！" layout_gravity="center" font="face:微软雅黑,size:24,bold:1" colorText="@color/clr_title"/>
    </window>
    <text layout_gravity="center" extend_top="12" font="face:微软雅黑,size:12" colorText="@color/clr_text">协议类型：自定义开源协议，商业化产品收费，个人免费产品免费使用，具体参考license.txt</text>
    <text layout_gravity="center" extend_top="6" font="face:微软雅黑,size:12" colorText="@color/clr_text_sub">版权所有：启程软件</text>
    <!-- 社区链接 -->
    <window size="-1,-1" layout="hbox" gravity="center" interval="10" extend_top="16" layout_gravity="center">
      <link href="https://www.cnblogs.com/setoutsoft/" class="cls_btn_weblink">SOUI教程</link>
      <link href="https://soui.com.cn/bbs" class="cls_btn_weblink">SOUI论坛</link>
    </window>
  </window>

  <!-- 卡片:QQ 交流群 -->
  <window size="-2,-1" skin="skin_card" layout="vbox" padding="14,13,14,15" extend_top="12">
    <window size="-2,14" layout="hbox" gravity="center" interval="8">
      <window size="3,12" skin="skin_card_bar"/>
      <text text="QQ 交流群" font="face:微软雅黑,size:12,bold:1" colorText="@color/clr_text_sub"/>
    </window>
    <window size="-2,-1" layout="gridlayout" interval="10" columnCount="3" gravity="fill" extend_top="12">
      <text font="face:微软雅黑,size:12" colorText="@color/clr_text" layout_gravity="center_vertical">QQ群#1(2000人)：</text>
      <edit readOnly="1" class="cls_edit" font="face:微软雅黑,size:12" colorText="@color/clr_text">229313785</edit>
      <link href="http://jq.qq.com/?_wv=1027&k=PxXh59" class="cls_btn_weblink">申请群#1</link>

      <text font="face:微软雅黑,size:12" colorText="@color/clr_text" layout_gravity="center_vertical">QQ群#2(500人)：</text>
      <edit readOnly="1" class="cls_edit" font="face:微软雅黑,size:12" colorText="@color/clr_text">385438344</edit>
      <link href="http://jq.qq.com/?_wv=1027&k=VRATCo" class="cls_btn_weblink">申请群#2</link>
    </window>
  </window>

  <!-- 卡片:代码仓库 + 二维码 -->
  <window size="-2,-1" skin="skin_card" layout="vbox" padding="14,13,14,15" extend_top="12">
    <window size="-2,14" layout="hbox" gravity="center" interval="8">
      <window size="3,12" skin="skin_card_bar"/>
      <text text="代码仓库" font="face:微软雅黑,size:12,bold:1" colorText="@color/clr_text_sub"/>
    </window>
    <window size="-2,-1" layout="hbox" gravity="center" interval="20" extend_top="12">
      <window size="0,-1" weight="1" layout="gridlayout" interval="10" columnCount="2" gravity="fill">
        <text font="face:微软雅黑,size:12" colorText="@color/clr_text" layout_gravity="center_vertical">github：</text>
        <edit readOnly="1" class="cls_edit" font="face:微软雅黑,size:12" colorText="@color/clr_text">https://github.com/soui4/soui</edit>
        <text font="face:微软雅黑,size:12" colorText="@color/clr_text" layout_gravity="center_vertical">gitee：</text>
        <edit readOnly="1" class="cls_edit" font="face:微软雅黑,size:12" colorText="@color/clr_text">https://gitee.com/setousoft/soui4</edit>
        <text font="face:微软雅黑,size:12" colorText="@color/clr_text" layout_gravity="center_vertical">gitcode：</text>
        <edit readOnly="1" class="cls_edit" font="face:微软雅黑,size:12" colorText="@color/clr_text">https://gitcode.com/setousoft/soui4</edit>
      </window>
      <qrctrl size="100,100" text="Using Soui, UI just so so!" msgTransparent="0" layout_gravity="center" tip="Using Soui, UI just so so!"/>
    </window>
  </window>
</window>
