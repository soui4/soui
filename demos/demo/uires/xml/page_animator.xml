<?xml version="1.0" encoding="utf-8"?>
<!--
  page_animator.xml - 动画演示分区

  controls 页按行组织动图演示:第一行为 GIF(horse)与"加载本地 GIF"按钮,
  第二行为企鹅 GIF / LOGO 图标 / APNG / 多帧动画,第三行为滚动字幕;
  素材固有尺寸:horse 93x70、penguin 120x95、apng 188x103、page_icons 帧 48x48。
  interpolator 页演示插值算法对动画曲线的影响。
  giftest/gif_test/btnSelectGif/cbx_interpolator/view_interpolator 的
  name 被 MainDlg_Misc.cpp / MainDlg_Animation.cpp 引用,不可改动。
-->
<tabctrl size="-2,-2" colorBkgnd="@color/clr_window_bg" colorText="@color/clr_text" colorTextHover="@color/clr_title" colorTextPush="@color/clr_primary" font="face:微软雅黑,size:13" fontPush="bold:1" focusable="0" animateSteps="10" animateType="1" tabAlign="left" tabSkin="skin_tab_nav" tabInterSize="4" tabPos="8" tabWidth="200" tabHeight="40" iconSkin="svg_tab_animator" icon-x="18" icon-y="12" text-x="42" drawFocusRect="0">
  <page title="controls" iconIndex="0" layout="vbox" padding="20,16,20,18">
    <!-- 页头 -->
    <text text="动图播放" font="face:微软雅黑,size:22,bold:1" colorText="@color/clr_title"/>
    <text text="GIF / APNG 播放与滚动字幕，点击按钮可加载本地 GIF 文件" extend_top="6" font="face:微软雅黑,size:12" colorText="@color/clr_text"/>
    <!-- 卡片:GIF / APNG 演示 -->
    <window size="-2,-1" skin="skin_card" padding="14,13,14,15" layout="vbox" extend_top="16">
      <window size="-2,14" layout="hbox" gravity="center" interval="8">
        <window size="3,12" skin="skin_card_bar"/>
        <text text="GIF / APNG" font="face:微软雅黑,size:12,bold:1" colorText="@color/clr_text_sub"/>
      </window>
      <window size="-2,-1" layout="hbox" interval="20" gravity="center" extend_top="12">
        <gifplayer size="93,70" skin="gif_horse" name="giftest" show="1" layout_gravity="center"/>
        <button size="150,30" name="btnSelectGif" layout_gravity="center" skin="skin_btn" font="face:微软雅黑,size:13" colorText="@color/clr_title" drawFocusRect="0">load gif file</button>
      </window>
      <window size="-2,-1" layout="hbox" interval="20" gravity="center" extend_top="16">
        <gifplayer size="120,95" skin="gif_penguin" show="1" id="1000" name="gif_test"/>
        <icon src="ICON_LOGO:64" size="64,64" layout_gravity="center"/>
        <gifplayer size="188,103" skin="apng_haha"/>
        <animateimg size="48,48" skin="skin_page_icons" autoStart="1" layout_gravity="center"/>
      </window>
    </window>
    <!-- 卡片:滚动字幕 -->
    <window size="-2,0" weight="1" skin="skin_card" padding="14,13,14,15" layout="vbox" gravity="fill" extend_top="12">
      <window size="-2,14" layout="hbox" gravity="center" interval="8">
        <window size="3,12" skin="skin_card_bar"/>
        <text text="scrolltext 滚动字幕测试" font="face:微软雅黑,size:12,bold:1" colorText="@color/clr_text_sub"/>
      </window>
      <window size="-2,0" weight="1" layout="hbox" interval="12" gravity="fill" extend_top="12">
        <window size="0,-2" weight="1" layout="vbox" interval="8">
          <text text="单行超宽 rollType=0：首尾衔接的循环水平滚动" font="face:微软雅黑,size:12" colorText="@color/clr_text_sub"/>
          <scrolltext size="-2,-1" rollType="0" colorText="@color/clr_primary" speed="10">这是单行超宽时的水平滚动演示，内容很长很长，以首尾衔接的方式循环滚动展示。</scrolltext>
          <text text="单行超宽 rollType=1：滚到末尾后回到起点" font="face:微软雅黑,size:12" colorText="@color/clr_text_sub"/>
          <scrolltext size="-2,-1" rollType="1" colorText="@color/clr_primary" speed="10">单行非衔接水平滚动：滚动到文本末尾后回到起点，用于观察非衔接效果。</scrolltext>
          <text text="多行 rollType=0 staytime=1500：逐行垂直滚动并回环" font="face:微软雅黑,size:12" colorText="@color/clr_text_sub"/>
          <scrolltext size="-2,-1" colorText="@color/clr_primary" speed="10" staytime="1500" rollType="0">第一行内容\n第二行内容\n第三行内容\n第四行内容</scrolltext>
        </window>
        <window size="0,-2" weight="1" layout="vbox" interval="8">
          <text layout_gravity="left" text="多行超宽行 rollType=0：停留期水平展示" font="face:微软雅黑,size:12" colorText="@color/clr_text_sub"/>
          <scrolltext size="-2,-1" colorText="@color/clr_primary" speed="10" staytime="2500" rollType="0">短行内容\n这是一条非常非常长的内容，超出了显示宽度，自动水平滚动以展示完整内容\n末尾行回环到首行</scrolltext>
          <text layout_gravity="left" text="多行 rollType=1 staytime=1500：末行停驻不再滚动" font="face:微软雅黑,size:12" colorText="@color/clr_text_sub"/>
          <scrolltext  size="-2,-1" colorText="@color/clr_primary" speed="10" staytime="1500" rollType="1">首行\n中间行\n末行显示完成后停驻不再滚动</scrolltext>
        </window>
      </window>
    </window>
  </page>
  <page title="interpolator" iconIndex="1" layout="vbox" padding="20,16,20,18">
    <!-- 页头 -->
    <text text="插值器" font="face:微软雅黑,size:22,bold:1" colorText="@color/clr_title"/>
    <text text="选择插值算法，观察下方滑块的动画曲线差异" extend_top="6" font="face:微软雅黑,size:12" colorText="@color/clr_text"/>
    <combobox size="300,30" name="cbx_interpolator" dropdown="1" class="cls_edit" btnSkin="skin_cbx_btn" extend_top="16" font="face:微软雅黑,size:13" drawFocusRect="0">
		  <dropdownStyle>
			  <root colorBkgnd="@color/clr_card_bg"/>
		  </dropdownStyle>
      <!-- 下拉列表:边框由 ncskin 画在窗口非客户区(最外 6px 环),滚动条落在客户区内、被圆角描边包住 -->
      <liststyle class="cls_edit" skin="none" ncskin="skin_popup" margin="6"
                 colorBkgnd="@color/clr_card_bg" sbSkin="skin_scrollbar" sbWid="6" sbArrowSize="0"
                 iconSkin="skin_menuicon" itemHeight="30" itemSkin="skin_lb_item" drawFocusRect="0"/>
      <items>
        <item text="SLinearInterpolator" icon="1" data="100"/>
        <item text="SAccelerateInterpolator" icon="2" data="100"/>
        <item text="SDecelerateInterpolator" icon="3" data="103"/>
        <item text="SAccelerateDecelerateInterpolator" icon="4" data="100"/>
        <item text="SAnticipateInterpolator" icon="5" data="105"/>
        <item text="SAnticipateOvershootInterpolator" icon="0" data="100"/>
        <item text="SBounceInterpolator" icon="0" data="100"/>
        <item text="SCycleInterpolator" icon="0" data="100"/>
        <item text="SOvershootInterpolator" icon="0" data="100"/>
        <item text="SQuadInInterpolator" icon="0" data="100"/>
        <item text="SQuadOutInterpolator" icon="0" data="100"/>
        <item text="SQuadInOutInterpolator" icon="0" data="100"/>
        <item text="SQuintInInterpolator" icon="0" data="100"/>
        <item text="SQuintOutInterpolator" icon="0" data="100"/>
        <item text="SQuintInOutInterpolator" icon="0" data="100"/>
        <item text="SCubicInInterpolator" icon="0" data="100"/>
        <item text="SCubicOutInterpolator" icon="0" data="100"/>
        <item text="SCubicInOutInterpolator" icon="0" data="100"/>
        <item text="SSineInInterpolator" icon="0" data="100"/>
        <item text="SSineOutInterpolator" icon="0" data="100"/>
        <item text="SSineInOutInterpolator" icon="0" data="100"/>
        <item text="SExpoInInterpolator" icon="0" data="100"/>
        <item text="SExpoOutInterpolator" icon="0" data="100"/>
        <item text="SExpoInOutInterpolator" icon="0" data="100"/>
        <item text="SBackInInterpolator" icon="0" data="100"/>
        <item text="SBackOutInterpolator" icon="0" data="100"/>
        <item text="SBackInOutInterpolator" icon="0" data="100"/>
      </items>
    </combobox>
    <!-- 插值器演示条:原来只给了 colorBkgnd,走 SSliderBar 的内置绘制(直角蓝条 + GDI 椭圆手柄),
         在 125% DPI 下填充两端是硬边、手柄边缘发虚有锯齿;这里换成与"基础控件-进度条控件"页
         完全相同的一套皮肤:6px 浅灰圆角轨道 + 青色胶囊填充 + 白色圆手柄,全部矢量绘制。
         colorBkgnd 原来铺了整块灰底(clr_divider),一并去掉,露出页面白底 -->
    <interpolatorView size="-2,30" name="view_interpolator" speed="2" extend_top="12"
                      thumbInRail="0" bkgndSkin="skin_slider_rail" posSkin="skin_prog_bar"
                      thumbSkin="skin_slider_thumb"/>
  </page>
  <page title="Android动画" iconIndex="2">
    <include src="layout:page_ani3"/>
  </page>
</tabctrl>
