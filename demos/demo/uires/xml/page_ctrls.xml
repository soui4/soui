﻿<?xml version="1.0"?>
<!--
  page_ctrls.xml - 基础控件演示分区

  左侧 grouplist(gl_catalog) 为控件分类目录,右侧 tab_ctrls(tabWidth=0 隐藏页签)
  承载 16 个控件演示子页,页切换由 MainDlg_List.cpp 响应目录点击驱动。
  每个子页采用统一版式:页头(标题+说明) -> 演示区(卡片容器无底色,由页面根的
  半透明 clr_page_bg 统一衬底,透出换肤层 demoskinbk);列表类演示页同为页头 + 全区域列表(weight 撑满)。
  注意:控件 name/id 被 demos\demo 源码按名引用,不可改动。
-->
<window size="-2,-2" layout="hbox" colorBkgnd="@color/clr_page_bg">
	<grouplist size="200,-2" name="gl_catalog" layout="vbox" viewSize="-2,-1" colorBkgnd="@color/clr_card_bg">
		<groupTemplate layout="vbox" size="-2,-1">
			<button name="title" size="-2,38" padding="10,5,10,5" layout="hbox" gravity="center" colorText="@color/clr_title">
				<text name="txt_label" weight="1" font="adding:5,bold:1" />
				<toggle skin="_skin.sys.tree.toggle" name="tgl_switch" toggled="1" msgTransparent="1" />
			</button>
			<aniwindow name="container" layout="vbox" size="-2,-1" Interpolator="Accelerate" factor="1.0" steps="10" gravity="center" />
		</groupTemplate>
		<itemTemplate size="-2,30" layout="hbox" gravity="center" class_name="check2" skin="_skin.sys.list.item">
			<img skin="svg_ctrl_icons" name="img_indicator" size="20,20" iconIndex="0" />
			<text name="txt_label" extend_left="10" colorText="@color/clr_text" />
		</itemTemplate>
		<data>
			<group text="列表控件" id="1000" tip="列表控件TIP">
				<item text="多列列表" icon="0" name="page_mclistview" id="100" tip="多列列表TIP"/>
				<item text="基础列表" icon="1" name="page_listctrl" id="101" />
				<item text="固定高度列表" icon="2" name="page_fix_height_listview" id="102" />
				<item text="可变高度列表" icon="3" name="page_flex_height_listview" id="103" />
				<item text="TileView" icon="4" name="page_tileview" id="104" />
			</group>
			<group text="树型控件" id="2000">
				<item text="TreeCtrl" icon="6" name="page_treectrl" id="105" />
				<item text="TreeView" icon="7" name="page_treeview" id="106" />
			</group>
			<group text="编辑器及热键" id="3000">
				<item text="编辑器" icon="8" name="page_edit" id="107" />
				<item text="富文本" icon="9" name="page_richedit" id="108" />
			</group>
			<group text="按钮" id="4000">
				<item text="按钮" icon="10" name="page_button" id="109" />
				<item text="radio button" icon="11" name="page_radio_button" id="110" />
			</group>
			<group text="其它控件" id="5000">
				<item text="进度条控件" icon="12" name="page_progress" id="111" />
				<item text="分割窗口" icon="13" name="page_splitwnd" id="113" />
				<item text="列表框及组合框" icon="14" name="page_listbox" id="114" />
				<item text="日历" icon="15" name="page_calendar" id="112" />
				<item text="属性表控件" icon="16" name="page_property" id="115" />
				<item text="更多控件" icon="17" name="page_morectrl" id="116" />
			</group>
		</data>
	</grouplist>
	<tabctrl size="0,-2" weight="1" padding="5,5,5,5" name="tab_ctrls" colorText="@color/clr_title" animateSteps="20" tabAlign="left" tabWidth="0">
		<!-- ============ 列表类演示:页头 + 全区域列表(weight 撑满) ============ -->
		<page title="mclistview" layout="vbox" interval="12">
				<text text="多列列表" font="size:16,bold:1" colorText="@color/clr_title"/>
				<text text="报表式多列虚拟列表,表头支持排序拖换与全选,条目模板内可嵌入任意控件" extend_top="2" font="size:12" colorText="@color/clr_text_sub"/>
				<window layout="hbox" interval="16">
				<check name="chk_multi_mclv" text="启用多选(关闭后点击为单选)" checked="1" font="size:12"/>
				<check name="chk_band_mclv" text="启用框选(关闭后多选拖动为 fling 滚动)" checked="1" font="size:12"/>
				<text name="txt_mclv_selcount" text="已选 0 项" font="size:12" colorText="@color/clr_primary" marginSize="8,0,0,0"/>
				</window>
				<mclistview name="mclv_test" multiSel="1" colorBkgnd="@color/clr_card_bg" size="-2,0" weight="1" headerHeight="30" dividerSize="1">
				<headerStyle wndclass="header" align="center" name="mclv_test_header" sortSkin="skin_lcex_header_arrow" itemSwapEnable="1" fixWidth="0" font="underline:0,adding:-3" sortHeader="1" colorBkgnd="#ffffff">
					<items>
						<item weight="480" align="left">@string/mccol_1</item>
						<item weight="95" >@string/mccol_2</item>
						<item weight="100" >@string/mccol_3</item>
						<item weight="100" align="right">@string/mccol_4</item>
						<item weight="100">@string/mccol_5</item>
						<item weight="100">@string/mccol_6</item>
					</items>
					<check name="chk_mclv_sel" text="全选" />
				</headerStyle>
				<template itemHeight="80" colorHover="@color/clr_card_hover" colorSelected="#DBEAFE">
					<window name="col1" clipClient="1">
						<img name="img_icon" skin="skin_icon6" pos="10,8,@64,@64" />
						<text name="txt_name" pos="[5,16" font="bold:1,adding:-1" colorText="@color/clr_title">火狐浏览器</text>
						<text name="txt_desc" pos="{0,36,-10,-10" font="bold:1,adding:-4" dotted="1" colorText="@color/clr_text_sub">速度最快的浏览器</text>
						<text name="txt_index" pos="|0,|0" offset="-0.5,-0.5" font="adding:10" colorText="rgba(37,99,235,53%)">10</text>
					</window>
					<window name="col2" clipClient="1">
						<ratingbar name="rating_score" starSkin="skin_star1" starNum="5" value="3.5" pos="10,16" />
						<text name="txt_score" pos="10,36" font="adding:-5">8.5分</text>
						<link pos="[5,36" cursor="hand" colorText="@color/clr_primary" href="www.163.com" font="adding:-5">投票</link>
					</window>
					<window name="col3" clipClient="1">
						<text name="txt_size" pos="0,26,-0,-26" font="adding:-4" align="center">85.92M</text>
					</window>
					<window name="col4" clipClient="1">
						<text name="txt_installtime" pos="0,26,-0,-26" font="adding:-4" align="center">2015-01-09</text>
					</window>
					<window name="col5" clipClient="1">
						<text name="txt_usetime" pos="0,26,-0,-26" font="adding:-4" align="center">今天</text>
						<animateimg pos="|0,|0" offset="-0.5,-0.5" skin="skin_busy" name="ani_test" tip="animateimg is used here" msgTransparent="0" />
					</window>
					<window name="col6" clipClient="1">
						<button animate="1" pos="|-35,|-14,@60,@26" font="adding:-3" align="center" name="btn_uninstall">卸载</button>
					</window>
				</template>
			</mclistview>
		</page>
		<page title="listctrl" layout="vbox" interval="12">
				<text text="基础列表" font="size:16,bold:1" colorText="@color/clr_title"/>
				<text text="报表式列表,演示表头排序、拖换与热跟踪光标;框选矩形使用可配置的 bandSkin(系统内置 _skin.sys.selband,colorrect 皮肤)" extend_top="2" font="size:12" colorText="@color/clr_text_sub"/>
				<window layout="hbox" interval="16">
				<check name="chk_multi_lc" text="启用多选(关闭后点击为单选)" checked="1" font="size:12"/>
				<check name="chk_band_lc" text="启用框选(关闭后多选拖动为 fling 滚动)" checked="1" font="size:12"/>
				<text name="txt_lc_selcount" text="已选 0 项" font="size:12" colorText="@color/clr_primary" marginSize="8,0,0,0"/>
				</window>
				<listctrl name="lc_test" multiSelection="1" hotTrack="1" size="-2,0" weight="1" itemHeight="28" headerHeight="30" colorBkgnd="@color/clr_card_bg" colorItemHotBkgnd="@color/clr_card_hover" colorItemSelBkgnd="#DBEAFE" colorText="@color/clr_text" colorSelText="@color/clr_title" bandSkin="_skin.sys.selband" sbSkin="skin_new_scrollbar" font="size:12">
				<headerStyle align="left" itemSwapEnable="1" fixWidth="0" sortHeader="1" sortSkin="skin_lcex_header_arrow" colorBkgnd="@color/clr_card_bg" colorText="@color/clr_title" font="size:12,bold:1">
					<items>
						<item width="150" weight="1">姓名</item>
						<item width="100">性别</item>
						<item width="80">年龄</item>
						<item width="100">成绩</item>
					</items>
				</headerStyle>
			</listctrl>
		</page>
		<page title="listview(fix)" layout="vbox" interval="10" >
			<text text="固定高度列表 listview" font="size:16,bold:1" colorText="@color/clr_title"/>
			<text text="横向与纵向的定高虚拟列表,item 内可嵌入任意子控件" extend_top="2" font="size:12" colorText="@color/clr_text_sub"/>
			<window layout="hbox" interval="16">
			<check name="chk_multi_lvfix" text="启用多选(关闭后点击为单选)" checked="1" font="size:12"/>
			<check name="chk_band_lvfix" text="启用框选(关闭后多选拖动为 fling 滚动)" checked="1" font="size:12"/>
			</window>
			<listview size="-2,100" name="lv_test_fix_horz" multiSel="1" dividerSize="5" wantTab="1" sbFadeFrames="30" vertical="0">
				<template itemWidth="100" trackMouseEvent="1">
					<imgbtn size="-2,-2" layout="vbox" gravity="center" interval="10">
						<img size="-1,-1" name="btn_icon" skin="skin_page_icons" iconIndex="0"/>
						<text size="-1,-1" name="btn_text" text="hello"/>
					</imgbtn>
				</template>
			</listview>
			<listview size="-2,0" weight="1" name="lv_test_fix" multiSel="1" dividerSize="5" wantTab="1" sbFadeFrames="30">
				<template itemHeight="50" trackMouseEvent="1">
					<button pos="10,5,@150,@25" name="btn_test" tip="click the button to see how to writing the response function">btn</button>
					<animateimg pos="[10,{0" skin="skin_busy" name="ani_test" tip="animateimg is used here" msgTransparent="0" />
					<combobox name="cbx_in_lv" pos="[10,{0,@200,@30" dropDown="1" dropHeight="300" class="cls_edit" dotted="0" animateTime="200" curSel="2">
						<dropdownStyle>
							<root colorBkgnd="#ffffff"/>
						</dropdownStyle>
						<liststyle class="cls_edit" iconSkin="skin_menuicon" itemHeight="30"/>
						<editstyle inset="5,0,5,0" margin="0" align="left"/>
						<items>
							<item text="combobox.item1" icon="1" data="100" />
							<item text="combobox.item2" icon="2" data="100" />
							<item text="combobox.item3" icon="3" data="103" />
							<item text="combobox.item4" icon="4" data="100" />
							<item text="combobox.item5" icon="5" data="105" />
							<item text="combobox.item6" icon="0" data="100" />
						</items>
					</combobox>
					<text pos="-20,{0" offset="-1,0">text item</text>
				</template>
			</listview>
		</page>
		<page title="listview(flex)" layout="vbox" interval="12">
				<text text="可变高度列表" font="size:16,bold:1" colorText="@color/clr_title"/>
				<text text="奇偶行使用不同模板与高度的虚拟列表,悬停态可单独定制" extend_top="2" font="size:12" colorText="@color/clr_text_sub"/>
				<window layout="hbox" interval="16">
				<check name="chk_multi_lvflex" text="启用多选(关闭后点击为单选)" checked="1" font="size:12"/>
				<check name="chk_band_lvflex" text="启用框选(关闭后多选拖动为 fling 滚动)" checked="1" font="size:12"/>
				</window>
				<listview size="-2,0" weight="1" name="lv_test_flex" multiSel="1" dividerSize="5" sbFadeFrames="30">
				<template defHeight="50" oddHeight="50" evenHeight="60" evenSelHeight="90">
					<itemOdd>
						<button pos="10,5,@150,@25" name="btn_test" tip="click the button to see how to writing the response function">btn</button>
						<text pos="10,[0" multiLines="1" maxWidth="500" colorText="@color/clr_primary">text in odd item</text>
					</itemOdd>
					<itemEven>
						<button pos="10,5,@150,@25" name="btn_test" tip="click the button to see how to writing the response function">btn</button>
						<text pos="20,[0" colorText="@color/clr_text">text in even item</text>
					</itemEven>
					<itemEvenHover>
						<button pos="10,5,@150,@25" name="btn_test" tip="click the button to see how to writing the response function">btn</button>
						<text pos="20,[0" colorText="@color/clr_text" multilines="1">text in even item been hovered.\n the second line</text>
					</itemEvenHover>
				</template>
			</listview>
		</page>
		<page title="tileview" layout="vbox" interval="12">
				<text text="TileView" font="size:16,bold:1" colorText="@color/clr_title"/>
				<text text="平铺网格虚拟列表,适合图标卡片式内容展示" extend_top="2" font="size:12" colorText="@color/clr_text_sub"/>
				<window layout="hbox" interval="16">
				<check name="chk_multi_tile" text="启用多选(关闭后点击为单选)" checked="1" font="size:12"/>
				<check name="chk_band_tile" text="启用框选(关闭后多选拖动为 fling 滚动)" checked="1" font="size:12"/>
				</window>
				<tileview size="-2,0" weight="1" name="lv_test_tile" multiSel="1" wantTab="1" marginSize="5" sbFadeFrames="30">
				<template itemHeight="130" itemWidth="135" trackMouseEvent="1">
					<img pos="|0,0,@100,@100" offset="-0.5,0" name="img_file_icon" />
					<button pos="|0,[5,@115,@22" offset="-0.5,0" name="btn_test" tip="click the button to see how to writing the response function">btn</button>
				</template>
			</tileview>
		</page>
		<!-- ============ 树型控件 ============ -->
		<page title="treectrl" layout="vbox" interval="12">
				<text text="TreeCtrl" font="size:16,bold:1" colorText="@color/clr_title"/>
				<text text="经典树控件,支持复选框、节点图标与多级组织结构" extend_top="2" font="size:12" colorText="@color/clr_text_sub"/>
				<window layout="hbox" interval="16">
					<check name="chk_multi_tree" text="启用多选(关闭后清除多选)" checked="1" font="size:12"/>
					<check name="chk_band_tree" text="启用框选(关闭后多选拖动为 fling 滚动)" checked="1" font="size:12"/>
					<check name="chk_fullrow_tree" text="整行选中(关闭后只高亮文本)" checked="1" font="size:12"/>
				</window>
				<window size="-2,0" weight="1" clipClient="1">
					<include src="layout:treectrl" />
				</window>
			</page>
		<page title="treeview">
			<include src="layout:page_treeview" />
		</page>
		<!-- ============ 编辑器及热键 ============ -->
		<page title="edit" layout="vbox" interval="12">
			<text text="编辑器" font="size:16,bold:1" colorText="@color/clr_title"/>
			<text text="单行编辑、数字调节、热键、IP 地址与十六进制编辑" extend_top="2" font="size:12" colorText="@color/clr_text_sub"/>
			<window size="-2,-1" padding="14,12,14,12" layout="vbox" interval="12">
				<text text="单行编辑器（外层 window 开启 trackMouseEvent 可感知悬停）" font="bold:1" colorText="@color/clr_title"/>
				<window size="-2,-1" layout="hbox" interval="10">
					<window class="cls_edit" size="200,30" trackMouseEvent="1">
						<edit pos="0,0,-30,-0" font="adding:10" margin="0" cueText="cue text" cueColor="rgb(255,0,0)" password="1">scroll edit</edit>
						<button pos="-30,0,-0,-0">:)</button>
					</window>
					<window size="100,30" class="cls_edit" trackMouseEvent="1">
						<edit pos="0,0,-16,-0" name="edit_spin" notifyChange="1" margin-x="0" margin-y="0" />
						<spinButton pos="[0,0,-0,-0" max="100" min="1" value="31" buddy="edit_spin" />
					</window>
				</window>
				<window size="-2,-1" layout="hbox" interval="10">
					<text>hotkey 1:</text>
					<hotkey name="ctrl_hk1" width="200" height="25" class="cls_edit" hotKey="ctrl+shift+f2"/>
					<text extend_left="20">hotkey 2:</text>
					<hotkey name="ctrl_hk2" width="200" height="25" class="cls_edit" hotKey="ctrl+alt+f1"/>
				</window>
				<window size="-2,-1" layout="hbox" interval="10" gravity="center">
					<text>ip address control:</text>
					<ipctrl name="ip_test" width="200" height="25" class="cls_edit" ip="192.168.0.130"/>
				</window>
			</window>
			<window size="-2,0" weight="1" padding="14,12,14,12" layout="vbox" interval="8">
				<text text="hexedit 十六进制编辑器" font="bold:1" colorText="@color/clr_title"/>
				<hexedit name="ctrl_hexedit" size="-2,0" weight="1" AutoBytesPerRow="1" HexBkColor="#ffff80" AsciiBkColor="#78ebe6" clipClient="1"/>
			</window>
		</page>
		<page title="richedit" layout="vbox" interval="12" >
			<text text="富文本编辑器" font="size:16,bold:1" colorText="@color/clr_title"/>
			<text text="图文混排、格式化消息追加与 RTF 导入导出" extend_top="2" font="size:12" colorText="@color/clr_text_sub"/>
			<window size="-2,-1" layout="hbox" interval="10">
				<button name="btn_insert_gif" size="150,30" id="#id_test1">insert gif</button>
				<button name="btn_append_msg" size="150,30">append format msg</button>
				<button name="btn_richedit_open" size="150,30">open from rtf</button>
				<button name="btn_richedit_save" size="150,30">save to rtf</button>
			</window>
			<chatedit name="re_gifhost" size="-2,0" weight="1" bkgndBlend="1" class="cls_edit" sbFadeFrames="30" enableDragdrop="1" multiLines="1" vscrollBar="1"  wordWrap="1" autoVscroll="1" hscrollBar="0" wantReturn="1" wantTab="1" maxBuf="6400000" rtf="rtf:rtf_test" />
		</page>
		<!-- ============ 按钮类 ============ -->
		<page title="buttons" layout="vbox" interval="12" >
			<text text="按钮与交互" font="size:16,bold:1" colorText="@color/clr_title"/>
			<text text="消息框按钮、开关、超链接、图片消息处理、圆形裁剪与线条绘制" extend_top="2" font="size:12" colorText="@color/clr_text_sub"/>
			<window size="-2,-1" padding="14,12,14,12" layout="vbox" interval="12">
				<window size="-2,-1" layout="hbox" interval="20" gravity="center">
					<imgbtn name="btn_msgbox" width="200" height="40" accel="ctrl+alt+f9" font="bold:1" skin="win10btn" animate="1">show msg box</imgbtn>
					<text size="-1,-1" layout_gravity="center" multiLines="1">press "ctrl+alt+f9" to activate\nthe msgbox button</text>
					<window size="-1,-1" layout="hbox" interval="20" gravity="center">
						<switch />
						<switch checked="1"/>
					</window>
				</window>
				<window size="-2,-1" layout="hbox" interval="20" gravity="center">
					<link maxWidth="200" class="cls_btn_weblink" dotted="1" href="https://gitee.com/setoutsoft/soui4">https://gitee.com/setoutsoft/soui4</link>
					<img size="100,100" skin="skin_page_icons" iconIndex="2" tip="the image show how to handle message in SImageWnd,\n you can do it by simply setting msgTransparent to 0" msgTransparent="0" />
				</window>
				<window size="-2,-1" layout="hbox" interval="15" gravity="center">
					<button size="100,30" name="btn_lrc">磁吸窗口</button>
					<roundImg size="50,50" name="img_round" cornerSize="0" skin="skin_avatar_high" />
					<roundImg size="50,50" name="img_round2" cornerSize="10" skin="skin_avatar_high" />
					<roundWnd size="50,50" name="img_round3" cornerSize="20">
						<img pos="0,0,-0,-0" skin="skin_avatar_high"/>
						<button pos="0,-20,-0,-0" text="hello"/>
					</roundWnd>
					<button.link size="130,30" name="btn_tip">提示窗口演示</button.link>
				</window>
			</window>
			<window size="-2,0" weight="1" padding="14,12,14,12" layout="vbox" interval="8">
				<text text="hr 线条控件（水平 / 垂直 / 倾斜，可配置线型）" font="bold:1" colorText="@color/clr_title"/>
				<window size="-2,0" weight="1">
					<hr pos="10,[20,-10,@2" lineStyle="dashdotdot" mode="horizontal" lineColor="#ff0000" />
					<hr pos="10,{0,-10,-10" lineStyle="dash" mode="tilt" lineColor="#00ff00" />
					<hr pos="10,{0,@2,-10" lineStyle="solid" mode="vertical" lineColor="#0000ff" lineSize="2" />
				</window>
			</window>
		</page>
		<!-- ============ 单选按钮 ============ -->
		<page title="radiobox" layout="vbox" interval="12">
			<text text="单选按钮" font="size:16,bold:1" colorText="@color/clr_title"/>
			<text text="经典 radio、图片 radio、按钮组与 tabctrl 联动切换、图标型单选" extend_top="2" font="size:12" colorText="@color/clr_text_sub"/>
			<window size="-2,-1" interval="12" layout="hbox">
