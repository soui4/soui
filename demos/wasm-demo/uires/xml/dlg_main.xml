          <!-- 表头在 XML 里声明，行由宿主代码插入（SListCtrl 不支持内联 <item>）：
               见 soui_main.cpp 的 fillListDemo。 -->
          <listctrl name="lc_demo" size="0,-2" weight="1" itemHeight="26" headerHeight="28"
                    multiSel="1" colorBkgnd="@color/surface" colorText="@color/text"
