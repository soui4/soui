<?xml version="1.0" encoding="utf-8"?>
<!--
  xml/dlg_main.xml -- SOUI on WebAssembly 展示页

  这是官网展示用的那一版：一屏之内把 SOUI 的主要能力过一遍，版式和 demos/demo 的
  桌面向导一致（顶栏 + 页签 + 内容页），但只保留能在 wasm 构建图里跑起来的部分。

    0 概览      介绍 + 四张能力卡
    1 基础控件  radio/check/switch/toggle/progress/slider/combobox/listbox/calendar
    2 更多控件  hotkey/ipctrl（核心）+ ratingbar/lightbutton/verificationCodeEdit/
                grouplist（controls.extend）
    3 MVC       listview/tileview/treeview/mclistview，用一个子 tabctrl 切换；列表项与
                树节点由宿主适配器填，见 soui_main.cpp
    4 列表与树  treectrl + listctrl
    5 布局      gridLayout 嵌套 + 行列权重
    6 图形控件  progressRing / SpeedMeter / waveProgress / qrctrl
    7 表格      gridctrl + propgrid
    8 图表      HelloChart 折线 / 柱状 / 饼图
    9 编辑器    richedit(<edit>，含一个 number="1" 的数字框) + hexedit + Scintilla
   10 扩展控件  controls.extend 的 colorizeText / scrolltext
   11 动画      SAnimation 补间、SValueAnimator 值动画、SPropAnimator 属性动画
   12 Lua 游戏  消消乐 / 俄罗斯方块 / 坦克大战，内容来自 lua:games_script + layout:XML_PAGE_GAME
   13 模态表单  SModalRoot + SModalView 弹出表单，提交结果回填主页面

  尺寸按帧缓冲 800x600 写死（swinx/wasm.cmake 的 SWINX_FB_WIDTH/HEIGHT）；窗口由
  soui_main.cpp 以 WS_POPUP 建在 (0,0)，所以 client 坐标 == canvas 像素坐标。

  size 的特殊值按 SOUI 自己的定义（SOUI/include/interface/slayout-i.h）：
  -1 = SIZE_WRAP_CONTENT 自适应内容，-2 = SIZE_MATCH_PARENT 填满父容器。
  这和 Android 的 layout_width 约定正好相反，写反了不会报错，只会让自适应行
  拿到整个父容器的高度、把后面的行一路推出可视区。
-->
<!-- sendWheel2Hover：滚轮按光标下的窗口派发。默认关闭时只发给焦点窗口，
     而演示里的列表/树拿不到焦点，滚轮会被静默丢弃（桌面 demo 里这条也一直开着）。 -->
<SOUI name="wasmHost" title="@string/title" width="800" height="600"
       margin="0,0,0,0" resizable="0" wndType="appMain" appWnd="1" translucent="0"
       sendWheel2Hover="1">
  <!-- 脚本节点必须放在 <SOUI> 这一层：SHostWnd::Create 在解析完布局后按 src 取
       资源原始缓冲交给脚本模块执行（SOUI/src/core/shostwnd.cpp），然后 root 的
       on_init 才被调用。lua:games_script 对应 uires.idx 里 <lua> 组的 games_script。 -->
  <script src="lua:games_script"/>

  <root colorBkgnd="@color/page" layout="vbox"
        padding="12dp,10dp,12dp,10dp" interval="8dp" on_init="on_init">

    <!-- 顶栏：品牌 + 一句话介绍，右侧是官方 QQ 群与当前构建的渲染信息。
         品牌文字由宿主在 main() 里填成 "SOUI <版本号>"（SOUI_VER1..4，
         见 soui_main.cpp 的 fillBrand），XML 里只写一个占位词。
         背景用 white 而不是 _skin.sys.wnd.bkgnd：那张九宫格图带边框，
         在 800x600 的整屏上会把内容挤出一圈灰边。 -->
    <window size="-2,-1" layout="hbox" colorBkgnd="@color/surface"
            padding="12dp,7dp,12dp,7dp" interval="10dp" gravity="center">
      <text class="brand" name="app_brand">SOUI</text>
      <text class="hint">@string/hint</text>
      <window size="0,0" weight="1" visible="0"/>
      <text class="hint">@string/qq_group</text>
      <text class="hint">@string/stack_hint</text>
    </window>

    <!-- 页签头显示的是 sys 资源的浅灰底图 + 选中项蓝色下划线，所以文字用中深灰。
         不设 animateSteps：它会给 tabctrl 的动画器配时长，切页改走 STabSlider
         过渡——过渡期间 tabctrl 把新旧两页都 SetVisible(FALSE)，只显示那个
         覆盖整页的过渡窗口（STabCtrl.cpp:23-77）。过渡按时长推进，浏览器标签页
         被挂起（后台标签 rAF 停摆）时会停在一页都不显示的状态；关掉后
         SetCurSel 同步隐藏旧页、显示新页，点得更干脆。 -->
    <tabctrl name="tab_main" size="-2,0" weight="1"
             tabSkin="_skin.sys.tab.header" colorBkgnd="@color/page"
             colorText="#4B5563" colorTextHover="@color/accent"
             font="size:13dp" tabHeight="28dp" curSel="0">

      <page title="概览" layout="vbox" padding="12dp,10dp,12dp,10dp" interval="10dp">
        <text class="h1" size="-2,-1">@string/ov_title</text>
        <text class="body" size="-2,-1" multiLines="1" wordBreak="1">@string/ov_body</text>
        <!-- 2x2 能力卡。单元格宽度写死 371dp：(页宽 776 - 左右 padding 24 - 列间距 10) / 2，
             卡片内文本区 = 371 - 左右 padding 24 = 347dp。
             size 不能写 0：0 是 SIZE_SPEC 的"指定尺寸 = 0 像素"，不是"自适应"；
             gridLayout 用子控件的期望尺寸决定行列大小，四张 0x0 的卡会全部叠在
             左上角（文字画得出来，因为文本不裁剪，但看上去是一团重叠的文本）。
             xGravity/yGravity=fill 之后行高会拉伸，卡片铺满整个网格区域。 -->
        <window name="ov_grid" size="-2,0" weight="1" layout="gridLayout"
                columnCount="2" rowCount="2" xInterval="10dp" yInterval="10dp"
                xGravity="fill" yGravity="fill">
          <window size="371dp,-1" rowWeight="1" colorBkgnd="@color/surface" layout="vbox"
                  padding="12dp,10dp,12dp,10dp" interval="5dp">
            <text class="h2" size="-2,-1">@string/ov_c1_t</text>
            <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">@string/ov_c1_d</text>
          </window>
          <window size="371dp,-1" rowWeight="1" colorBkgnd="@color/surface" layout="vbox"
                  padding="12dp,10dp,12dp,10dp" interval="5dp">
            <text class="h2" size="-2,-1">@string/ov_c2_t</text>
            <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">@string/ov_c2_d</text>
          </window>
          <window size="371dp,-1" rowWeight="1" colorBkgnd="@color/surface" layout="vbox"
                  padding="12dp,10dp,12dp,10dp" interval="5dp">
            <text class="h2" size="-2,-1">@string/ov_c3_t</text>
            <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">@string/ov_c3_d</text>
          </window>
          <window size="371dp,-1" rowWeight="1" colorBkgnd="@color/surface" layout="vbox"
                  padding="12dp,10dp,12dp,10dp" interval="5dp">
            <text class="h2" size="-2,-1">@string/ov_c4_t</text>
            <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">@string/ov_c4_d</text>
          </window>
        </window>
      </page>

      <page title="基础控件" layout="hbox" padding="12dp,10dp,12dp,10dp" interval="14dp">
        <window size="0,-2" weight="1" layout="vbox" interval="10dp">
          <text class="h1" size="-2,-1">@string/ctrls_h1</text>
          <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">@string/ctrls_body</text>
          <window size="-2,-1" layout="hbox" interval="16dp" gravity="center">
            <radio name="radio_a" colorText="@color/text" checked="1">选项 A</radio>
            <radio name="radio_b" colorText="@color/text">选项 B</radio>
            <radio name="radio_c" colorText="@color/text">选项 C</radio>
          </window>
          <window size="-2,-1" layout="hbox" interval="18dp" gravity="center">
            <switch name="sw_demo" checked="1"/>
            <toggle name="tgl_demo" toggled="1" skin="_skin.sys.tree.toggle"/>
            <check name="chk_demo" text="复选框" skin="_skin.sys.checkbox" class="body"/>
          </window>
          <window size="-2,-1" layout="hbox" interval="12dp" gravity="center">
            <text class="hint" size="70dp,-1">progress</text>
            <!-- 百分比文字是 showText（SProgress 的 ATTR_BOOL(showText, m_bShowText)），
                 写成 showPercent 不会报错，只是这个属性没人认，文字直接不画。 -->
            <progress name="prog_demo" colorText="@color/text" size="220dp,16dp"
                      value="62" min="0" max="100" showText="1"/>
          </window>
          <window size="-2,-1" layout="hbox" interval="12dp" gravity="center">
            <text class="hint" size="70dp,-1">sliderbar</text>
            <sliderbar name="slider_demo" size="220dp,-1" value="40" min="0" max="100"/>
          </window>
          <!-- combobox 的下拉窗是 SDropDownWnd（SHostWnd 子类）建的第二个软件宿主
               窗口——这一页就是 swinx wasm 弹出窗支持的验收页：下拉窗、点外关闭、
               关闭后的画面恢复全部走 swinx 的多窗口合成。dropDown="1" 只能下拉选；
               dropDown="0" 的那支还能直接打字。animateTime="0" 关掉下拉动画：
               STabSlider 的教训同样适用这里，动画时长在无真实时间推进的环境里不会结束。
               编辑框外观统一走 uidef/init.xml 的 editbox 类（ncSkin + margin 出边框，
               margin 为空时 OnNcPaint 不画边框）。 -->
          <window size="-2,-1" layout="hbox" interval="12dp" gravity="center">
            <text class="hint" size="70dp,-1">combobox</text>
            <combobox name="cbx_demo" size="0,30dp" weight="1" class="editbox" dropDown="1"
                      dropHeight="120dp" btnSkin="_skin.sys.dropbtn" animateTime="0" curSel="1"
                      cueText="下拉选择一项" cueColor="@color/textsub">
              <dropdownStyle>
                <root colorBkgnd="@color/surface"/>
              </dropdownStyle>
              <liststyle itemHeight="26dp" colorText="@color/text" colorBkgnd="@color/surface"/>
              <editstyle inset="5dp,0,5dp,0" margin="0" align="left" valign="center"
                         colorText="@color/text" colorBkgnd="@color/surface"/>
              <items>
                <item text="canvas2d —— 全部平台的软件渲染后端"/>
                <item text="imgdecoder-stb —— PNG/JPEG 解码"/>
                <item text="ScriptModule-LUA —— 脚本扩展"/>
                <item text="richedit41 —— 富文本编辑"/>
                <item text="Scintilla —— 代码编辑器"/>
              </items>
            </combobox>
          </window>
          <text class="h2" size="-2,-1">listbox</text>
          <listbox name="lb_demo" size="-2,0" weight="1" hotTrack="1" itemHeight="26dp"
                   colorBkgnd="@color/surface" colorText="@color/text"
                   colorItemHotBkgnd="#EFF3FB" colorItemSelBkgnd="@color/accentsoft"
                   colorSelText="#1E3A8A">
            <items>
              <item text="SWindow —— 一切控件的基类"/>
              <item text="SPanel —— 布局容器"/>
              <item text="SHostWnd —— 宿主窗口与消息泵"/>
              <item text="SAdapterBase —— 虚拟列表的数据源"/>
              <item text="SSkinObj —— 皮肤体系"/>
              <item text="SEventSet —— 事件订阅与冒泡"/>
            </items>
          </listbox>
        </window>
        <!-- calendar 没有皮肤也没有文字，GetDesiredSize 只能返回 0，写自适应会被压成
             0 高；它的分区高度和 6 行日期都按客户区高度分摊，所以给满高。
             colorHoverText 必须显式给：m_crHoverText 在 Init() 里没有初始化。 -->
        <calendar name="cal_demo" size="250dp,-2"
                  colorBkgnd="@color/surface" colorText="@color/text"
                  colorOtherText="@color/textsub" colorHoverText="@color/accent"
                  colorSelText="@color/text"/>
      </page>

      <!-- 更多控件页：hotkey / ipctrl 来自 SOUI 核心，ratingbar / lightbutton /
           verificationCodeEdit / grouplist 来自 controls.extend（SCtrlsRegister
           已把它们注册进 wasm 构建图）。grouplist 的折叠动画发生在页内的
           aniwindow 容器里；hotkey/ipctrl 的编辑框外观统一走 uidef/init.xml 的
           editbox 类（ncSkin + margin 出边框，margin 为空时 OnNcPaint 不画边框）。 -->
      <page title="更多控件" layout="hbox" padding="12dp,10dp,12dp,10dp" interval="14dp">
        <window size="0,-2" weight="1" layout="vbox" interval="8dp">
          <text class="h1" size="-2,-1">@string/more_h1</text>
          <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">@string/more_body</text>
          <window size="-2,-1" layout="hbox" interval="8dp" gravity="center">
            <text class="hint" size="56dp,-1">hotkey</text>
            <hotkey name="hk_demo" size="0,-1" weight="1" class="editbox" hotKey="ctrl+shift+f2"/>
          </window>
          <window size="-2,-1" layout="hbox" interval="8dp" gravity="center">
            <text class="hint" size="56dp,-1">ipctrl</text>
            <ipctrl name="ip_demo" size="0,-1" weight="1" class="editbox" ip="192.168.4.21"/>
          </window>
          <!-- ratingbar 的 starSkin 用 imglist 两帧雪碧图：DrawStars 按
               DrawByIndex(rt, rc, bForeground ? 0 : 1) 取帧，所以第 0 帧=亮星、
               第 1 帧=暗星（svg:star 的左半边/右半边）。 -->
          <text class="h2">ratingbar</text>
          <window size="-2,-1" layout="hbox" interval="12dp" gravity="center">
            <ratingbar name="rating_demo" size="180dp,30dp" starSkin="svg_star"
                       starNum="5" value="3.5"/>
            <text class="hint">3.5 / 5</text>
          </window>
          
          <text class="h2">verificationCodeEdit</text>
          <!-- 自绘验证码格子：每格一位，输入时数字逐格回显，格子里的背景字符
               是控件自己随机画的干扰码。 -->
          <verificationCodeEdit name="vcode_demo" size="-1,40dp" maxBuffer="6"
                                colorText="@color/text" colorBkgnd="@color/surface"/>
        </window>
        <window size="0,-2" weight="1" layout="vbox" interval="10dp">
          <text class="h2">grouplist</text>
          <!-- 折叠手风琴。groupTemplate 必须带 name="title" 的可点行和
               name="container" 的动画容器；itemTemplate 的 class_name 决定条目
               控件类，这里用 check2（SCheckBox2）做出可勾选条目。条目文字由
               宿主在 EventGroupListInitGroup/InitItem 回调里写（id=301 对应
               soui_main.cpp EVENT_MAP 里的三条 EVENT_ID_HANDLER），控件本身
               只发事件不改文字。 -->
          <grouplist name="gl_demo" id="301" size="-2,0" weight="1" layout="vbox" viewSize="-2,-1"
                     colorBkgnd="@color/surface">
            <groupTemplate layout="vbox" size="-2,-1">
              <button name="title" size="-2,32dp" padding="10dp,5dp,10dp,5dp" layout="hbox"
                      gravity="center" colorText="@color/text" colorBkgnd="#F3F4F6">
                <text name="txt_label" weight="1" font="size:13dp,bold:1"/>
                <toggle skin="_skin.sys.tree.toggle" name="tgl_switch" toggled="1"
                        msgTransparent="1"/>
              </button>
              <aniwindow name="container" layout="vbox" size="-2,-1" Interpolator="Accelerate"
                        factor="1.0" steps="10" gravity="center"/>
            </groupTemplate>
            <itemTemplate size="-2,28dp" layout="hbox" gravity="center"
                          class_name="check2" skin="_skin.sys.list.item">
              <text name="txt_label" extend_left="10dp" colorText="@color/text"/>
            </itemTemplate>
            <data>
              <group text="SOUI 核心" id="100">
                <item text="窗口与布局体系" id="101"/>
                <item text="资源管理与皮肤" id="102"/>
                <item text="事件与消息映射" id="103"/>
              </group>
              <group text="controls.extend" id="200">
                <item text="Scintilla / hexedit" id="201"/>
                <item text="图表与仪表盘" id="202"/>
                <item text="Lua 脚本游戏" id="203"/>
              </group>
            </data>
          </grouplist>
        </window>
      </page>

      <!-- MVC 页：数据源 → 适配器 → 虚拟列表/树。行内容由 soui_main.cpp 的两个适配器
           在 getView 里填（listview/tileview/mclistview 都不接受 XML 内联行，不挂
           适配器只会画出一行空模板），所以这一页在宿主接线之前只有一副空壳。
           四个视图塞进一个子 tabctrl：页签名就是控件类名，一眼能看出当前看的是哪个
           视图。前三个视图共用同一份行数组——换视图不换数据，改数据只要 notify 一次；
           treeview 走 STreeAdapterBase 的另一棵数据（树节点本来就不是一张平表），
           同样由适配器在 getView 里按名字填 txt_label。
           子 tabctrl 同样不设 animateSteps：外层页签头那段注释的理由对它一样成立。
           行内控件用 pos 绝对定位：模板节点的 layout 不会传给回收复用的 SItemPanel，
           写 hbox/vbox 只会得到一列叠在一行的控件。 -->
      <page title="MVC" layout="vbox" padding="12dp,10dp,12dp,10dp" interval="8dp">
        <text class="h1" size="-2,-1">MVC：500 行数据，四种视图，任意行模板</text>
        <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">SAdapterBase / SMcAdapterBase 把数据行绑定到模板窗口：下面的列表有 500 行，控件只为可视区里的十余行建窗口，滚动时回收复用。行模板不是一行文本——头像块、两行标题、说明、热度条、下载量都是模板里的普通控件，适配器按名字逐个填。四个视图用子页签切换，treeview 由 STreeAdapterBase 驱动。</text>
        <window size="-2,-1" layout="hbox" interval="8dp">
          <button name="btn_mvc_shuffle" text="打乱数据" skin="_skin.sys.btn.normal" class="body"/>
          <button name="btn_mvc_add" text="追加一行" skin="_skin.sys.btn.normal" class="body"/>
          <text name="mvc_status" class="stat" size="0,-1" weight="1"/>
        </window>
        <tabctrl name="tab_mvc" size="-2,0" weight="1"
                 tabSkin="_skin.sys.tab.header" colorBkgnd="@color/surface"
                 colorText="#4B5563" colorTextHover="@color/accent"
                 font="size:12dp" tabHeight="24dp" curSel="0">
          <!-- listview/tileview 的模板节点整体交给 SItemPanel::InitFromXml，
               所以两个视图用同一套子控件名，适配器一份 getView 就能同时填两边。
               行模板不是"一行文本"：头像块、两行名称/来源、说明、热度进度条、
               下载量各占一个矩形，回收复用的行窗口会整棵子树一起换内容。 -->
          <page title="listview" layout="vbox" padding="8dp,6dp,8dp,6dp" interval="6dp">
            <text class="hint" size="-2,-1">SListView：500 行数据只创建可视区里的十余行；行模板可以是任意控件树。</text>
            <listview name="mvc_lv" size="-2,0" weight="1" colorBkgnd="@color/surface"
                      colorText="@color/text" colorSelected="@color/accentsoft">
              <template itemHeight="48">
                <window name="item_icon" pos="10,9" size="30dp,30dp" colorBkgnd="#DBEAFE"
                        clipClient="1">
                  <text name="item_initial" pos="0,0,-0,-0" align="center" colorText="#1D4ED8"
                        font="size:14dp,bold:1"/>
                </window>
                <text name="item_name" pos="50,5" size="180dp,20dp" class="body"/>
                <text name="item_kind" pos="50,26" size="180dp,16dp" class="hint"/>
                <text name="item_note" pos="240,14" size="300dp,18dp" class="hint"/>
                <progress name="item_score" pos="550,19" size="90dp,10dp" value="50"
                          min="0" max="100" bkgndSkin="mvc_prog_track"
                          posSkin="mvc_prog_fill" showText="0"/>
                <text name="item_stat" pos="650,14" size="80dp,18dp" class="hint" align="right"/>
              </template>
            </listview>
          </page>
          <page title="tileview" layout="vbox" padding="8dp,6dp,8dp,6dp" interval="6dp">
            <text class="hint" size="-2,-1">STileView：同一份数据排成卡片网格，列数随宽度自适应。</text>
            <tileview name="mvc_tile" size="-2,0" weight="1" colorBkgnd="@color/surface"
                      colorText="@color/text" colorSelected="@color/accentsoft">
              <template itemWidth="168dp" itemHeight="100dp">
                <window name="item_icon" pos="|0,10" offset="-0.5,0" size="34dp,34dp"
                        colorBkgnd="#DBEAFE" clipClient="1">
                  <text name="item_initial" pos="0,0,-0,-0" align="center" colorText="#1D4ED8"
                        font="size:15dp,bold:1"/>
                </window>
                <text name="item_name" pos="|0,50" offset="-0.5,0" size="150dp,18dp"
                      align="center" class="body"/>
                <text name="item_kind" pos="|0,69" offset="-0.5,0" size="150dp,16dp"
                      align="center" class="hint"/>
                <progress name="item_score" pos="|0,88" offset="-0.5,0" size="120dp,8dp"
                          value="50" min="0" max="100" bkgndSkin="mvc_prog_track"
                          posSkin="mvc_prog_fill" showText="0"/>
              </template>
            </tileview>
          </page>
          <!-- treeview：行模板与 uieditor 的 workspace_treeview
               （demos/uieditor/uires/xml/dlg_main_left.xml）同构；hasLines 画出
               缩进连接线，点缩进区切换展开/收起（基类 ExpandItem 默认实现）。
               名字不能叫 tree_demo：列表与树页的 treectrl 占用了这个名字，
               FindChildByName2 按名字 + 类型找控件，重名会让命中顺序变得说不清。 -->
          <page title="treeview" layout="vbox" padding="8dp,6dp,8dp,6dp" interval="6dp">
            <text class="hint" size="-2,-1">STreeView：三层节点，点缩进区的箭头展开/收起；树节点同样由适配器按模板填。</text>
            <treeview name="mvc_tree" size="-2,0" weight="1" hasLines="1" indent="14dp"
                      colorBkgnd="@color/surface">
              <template height="24dp" layout="hbox" gravity="center" padding="4dp,0,4dp,0"
                        trackMouseEvent="1">
                <text name="txt_label" size="-1,-1" colorText="@color/text"/>
              </template>
            </treeview>
          </page>
          <!-- mclistview 的列宽不由模板决定：控件按表头宽度依次把名为 col1/col2/… 的
               子窗口 Move 到各列矩形（SMCListView.cpp:659-683），而 colN 这个名字来自
               适配器的 GetColumnName。名字对不上就不会被搬到位，列内容会全部堆在模板
               写死的 pos 上，拖动表头分隔线时更是纹丝不动。 -->
          <page title="mclistview" layout="vbox" padding="8dp,6dp,8dp,6dp" interval="6dp">
            <text class="hint" size="-2,-1">SMcListView：500 行、五列表格；表头分隔线可拖动，最后一列是每行自己的进度条。</text>
            <mclistview name="mvc_mclv" size="-2,0" weight="1" headerHeight="26" dividerSize="1"
                        colorBkgnd="@color/surface" colorText="@color/text">
              <headerStyle align="left" fixWidth="0" colorBkgnd="#F9FAFB"
                           colorText="#374151" font="size:12dp,bold:1">
                <items>
                  <item width="130">控件</item>
                  <item width="110">来源</item>
                  <item width="70">版本</item>
                  <item width="310">说明</item>
                  <item width="100">热度</item>
                </items>
              </headerStyle>
              <template itemHeight="28">
                <window name="col1" clipClient="1">
                  <text name="mc_c1" pos="6,5,-10,-5" class="body" dotted="1"/>
                </window>
                <window name="col2" clipClient="1">
                  <text name="mc_c2" pos="6,5,-10,-5" class="hint" dotted="1"/>
                </window>
                <window name="col3" clipClient="1">
                  <text name="mc_c3" pos="6,5,-10,-5" class="hint" dotted="1"/>
                </window>
                <window name="col4" clipClient="1">
                  <text name="mc_c4" pos="6,5,-10,-5" class="hint" dotted="1"/>
                </window>
                <window name="col5" clipClient="1">
                  <progress name="mc_score" pos="6,9,-8,-9" value="50" min="0" max="100"
                            bkgndSkin="mvc_prog_track" posSkin="mvc_prog_fill" showText="0"/>
                </window>
              </template>
            </mclistview>
          </page>
        </tabctrl>
      </page>

      <page title="列表与树" layout="vbox" padding="12dp,10dp,12dp,10dp" interval="8dp">
        <text class="h1" size="-2,-1">@string/list_h1</text>
        <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">@string/list_body</text>
        <window size="-2,0" weight="1" layout="hbox" interval="12dp">
          <!-- 选中行的底色来自 STreeCtrl 构造时默认挂上的内置 itemSkin，选中态文字
               走 SWindowStyle 的 colorTextPush；不设就会回落到 colorText（深灰），
               在浅蓝选中带上对比度不足。 -->
          <treectrl name="tree_demo" size="0,-2" weight="1" itemHeight="24" indent="18"
