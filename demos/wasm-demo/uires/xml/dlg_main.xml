      <page title="布局" layout="vbox" padding="12dp,10dp,12dp,10dp" interval="10dp">
        <text class="h1" size="-2,-1">@string/layout_h1</text>
        <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">@string/layout_body</text>
        <!-- 3x2 网格。单元格宽度 245dp = (页宽 776 - 左右 padding 24 - 两列间距 16) / 3。
             和概览页一样，size 写 0 会被当成"指定 0 像素"，六个格子会叠到左上角，
             所以这里给每张卡写死宽度、高度交回布局。
             每张卡里放的是**真的按该属性排布的子窗口**（不是写着属性名的标签）：
             烟测要能读矩形比对这些属性有没有生效，光有文字说明证明不了任何事。 -->
        <window name="grid_demo" size="-2,0" weight="1" layout="gridLayout"
                columnCount="3" rowCount="2" xInterval="8dp" yInterval="8dp"
                xGravity="fill" yGravity="fill">
          <window size="245dp,-1" rowWeight="1" colorBkgnd="@color/accentsoft" layout="vbox"
                  padding="10dp,8dp,10dp,8dp" interval="3dp">
            <text class="h2">weight = 1 : 2 : 3</text>
            <text class="hint">剩余空间按权重分给三个子块</text>
            <window name="lay_w_box" size="-2,0" weight="1" layout="hbox" interval="2dp" gravity="center">
              <window name="lay_w1" size="0,34dp" weight="1" colorBkgnd="#1D4ED8"/>
              <window name="lay_w2" size="0,34dp" weight="2" colorBkgnd="#3B82F6"/>
              <window name="lay_w3" size="0,34dp" weight="3" colorBkgnd="#93C5FD"/>
            </window>
          </window>
          <window size="245dp,-1" rowWeight="1" colorBkgnd="#E0F2FE" layout="vbox"
                  padding="10dp,8dp,10dp,8dp" interval="3dp">
            <text class="h2">interval = 14dp</text>
            <text class="hint">间距由布局统一给，不写 margin</text>
            <window size="-2,0" weight="1" layout="hbox" interval="14dp" gravity="center">
              <window name="lay_i1" size="24dp,24dp" colorBkgnd="#0EA5E9"/>
              <window name="lay_i2" size="24dp,24dp" colorBkgnd="#0EA5E9"/>
              <window name="lay_i3" size="24dp,24dp" colorBkgnd="#0EA5E9"/>
            </window>
          </window>
          <window size="245dp,-1" rowWeight="1" colorBkgnd="#DCFCE7" layout="vbox"
                  padding="10dp,8dp,10dp,8dp" interval="3dp">
            <text class="h2">layout_gravity</text>
            <text class="hint">同一个容器里三个子块各自左/中/右</text>
            <window name="lay_g_box" size="-2,0" weight="1" layout="vbox" interval="6dp">
              <window name="lay_g_left" size="120dp,12dp" layout_gravity="left" colorBkgnd="#059669"/>
              <window name="lay_g_center" size="120dp,12dp" layout_gravity="center" colorBkgnd="#10B981"/>
              <window name="lay_g_right" size="120dp,12dp" layout_gravity="right" colorBkgnd="#34D399"/>
            </window>
          </window>
          <!-- 容器 gravity 的轴由布局方向决定（SLinearLayout.cpp:414-445）：vbox 里它管**水平**
               对齐（center/right），hbox 里它管**垂直**对齐，而且 hbox 分支只实现了 G_Center 和
               G_Right——G_Right 走的是 `rcParent.Height() - rcChild.Height()`，也就是**底对齐**，
               不是右对齐。上一张卡的 layout_gravity 是子块各自覆盖容器值，这张卡是容器给所有子块。 -->
          <window size="245dp,-1" rowWeight="1" colorBkgnd="#FEF3C7" layout="vbox"
                  padding="10dp,8dp,10dp,8dp" interval="3dp">
            <text class="h2">容器 gravity=center</text>
            <text class="hint">hbox 里管垂直：两个不同高度的子块同中线</text>
            <window name="lay_gr_box" size="-2,0" weight="1" layout="hbox" interval="8dp" gravity="center">
              <window name="lay_gr_a" size="96dp,26dp" colorBkgnd="#F59E0B"/>
              <window name="lay_gr_b" size="40dp,12dp" colorBkgnd="#FBBF24"/>
            </window>
          </window>
          <!-- pos 的三种参考（SouiLayout::PositionItem2Value）：
               |0        = 相对父窗口中心，本身是"左边贴中心"，要再配 offset="-0.5,0" 才是水平居中；
               %25       = 父窗口宽度的 25%；
               四元组 x2,y2 写负值 = 这条边距父窗口右/下边界的距离，此时**不要**再写 size，
               宽高由两端坐标决定，父窗口变化时跟着拉伸（二元组只给左边/上边，参考右/下必须写满四个）。 -->
          <window size="245dp,-1" rowWeight="1" colorBkgnd="#FCE7F3" layout="vbox"
                  padding="10dp,8dp,10dp,8dp" interval="3dp">
            <text class="h2">pos 绝对定位</text>
            <text class="hint">|0 居中 / %25 百分比 / 四元组负值拉伸</text>
            <window name="lay_pos_box" size="-2,0" weight="1" colorBkgnd="#FDF2F8">
              <text name="lay_pos_center" pos="|0,2" offset="-0.5,0" size="132dp,16dp"
                    align="center" class="hint">|0 + offset -0.5</text>
              <text name="lay_pos_pct" pos="%25,24" size="96dp,16dp" class="hint">%25</text>
              <text name="lay_pos_neg" pos="2,46,-6,-6" align="center" class="hint">2,46,-6,-6 随父窗口拉伸</text>
            </window>
          </window>
          <window size="245dp,-1" rowWeight="1" colorBkgnd="#EDE9FE" layout="vbox"
                  padding="10dp,8dp,10dp,8dp" interval="3dp">
            <text class="h2">嵌套</text>
            <text class="hint">hbox 里套 vbox，右侧再挂一个自适应块</text>
            <window size="-2,0" weight="1" layout="hbox" interval="6dp">
              <window name="lay_n_box" size="60dp,-2" layout="vbox" interval="4dp">
                <window name="lay_n1" size="-2,16dp" colorBkgnd="#7C3AED"/>
                <window name="lay_n2" size="-2,16dp" colorBkgnd="#A78BFA"/>
              </window>
              <text name="lay_n3" class="hint" size="0,-1" weight="1">右侧 weight=1 撑满剩余宽度</text>
            </window>
          </window>
        </window>
      </page>

      <page title="图形控件" layout="vbox" padding="12dp,10dp,12dp,10dp" interval="10dp">
        <text class="h1" size="-2,-1">@string/chart_h1</text>
        <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">@string/chart_body</text>
        <window size="-2,0" weight="1" layout="hbox" interval="18dp" gravity="center">
          <progressRing name="ring_demo" size="130dp,130dp" value="68" min="0" max="100"
                        showText="1" colorText="@color/text"
                        colorBack="@color/divider" colorFore="@color/accent"/>
          <!-- SpeedMeter 的 value 走 SFloatAnimator，改一次数值就能看到指针过渡。 -->
          <SpeedMeter name="speed_demo" size="150dp,150dp"
                      value="180" minValue="0" maxValue="300" RingWidth="14"/>
          <!-- 水波靠 SOUI 的 timeline 心跳推进（SWaveProgress::OnNextFrame）：相位
               以波长为单位连续累加，两层波按不同速度、反方向漂移，后景波更矮，
               叠在一起才有一层层的水面感。静止的截图里看不出，浏览器里能看到波纹在动。 -->
          <waveProgress name="wave_demo" size="110dp,130dp" value="62" min="0" max="100"
                        colorBack="#F1F5F9" colorFore="@color/accent"
                        colorBorder="@color/divider" colorWave="#93C5FD"/>
          <qrctrl name="qr_demo" size="110dp,110dp" text="https://github.com/soui4/soui"
                  colorBkgnd="@color/surface"/>
        </window>
      </page>

      <!-- 表格页：SGridCtrl 是完整的电子表格（固定行列 + 多种单元格类型），
           SPropertyGrid 是属性面板。两者的内容都不能只靠 XML：
           gridctrl 的单元格文字必须走 SetItemText（XML 里没有内联单元格的语法），
           propgrid 的分组和条目由 <groups> 声明。 -->
      <page title="表格" layout="vbox" padding="12dp,10dp,12dp,10dp" interval="8dp">
        <text class="h1" size="-2,-1">表格控件：gridctrl 与 propgrid</text>
        <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">SGridCtrl 带固定行列、单元格类型和就地编辑；SPropertyGrid 把属性按分组树排布，双击分组行折叠/展开，双击值列直接改。</text>
        <window size="-2,-1" layout="hbox" interval="8dp">
          <button name="btn_tbl_addrow" text="加一行" skin="_skin.sys.btn.normal" class="body"/>
          <button name="btn_tbl_check" text="切换复选列" skin="_skin.sys.btn.normal" class="body"/>
          <text name="tbl_status" class="stat" size="0,-1" weight="1"/>
        </window>
        <window size="-2,0" weight="1" layout="hbox" interval="12dp">
          <!-- defColWidth 是像素：5 列 × 86 = 430，加上固定列后仍小于控件宽度，
               不会出现"表头画得下、单元格被推到可视区外"。
               单元格类型只用 TEXT/NUMERIC/CHECKBOX：URL 要 ShellExecute、COLOR 和
               DATETIMEPICKER 要真弹出窗口（都依赖 HWND），wasm 上没有对应实现。 -->
          <gridctrl name="tbl_grid" size="0,-2" weight="12" rowCount="7" colCount="5"
                    fixedRows="1" fixedCols="1" defRowHeight="26" defColWidth="86"
                    gridLineColor="@color/divider" gridBkColor="@color/surface"
                    colorText="@color/text" editable="1"/>
          <propgrid name="tbl_prop" size="0,-2" weight="8" titleWidth="110" itemHeight="26"
                    orderType="group" colorBkgnd="@color/surface" colorText="@color/text"
                    colorGroup="#EEF2FF" colorTitle="#F9FAFB" colorTitleSel="#E0F2FE"
                    colorTitleText="#374151" colorTitleTextSel="#1E3A8A"
                    colorItem="#FFFFFF" colorItemBorder="@color/divider">
            <!-- cmdbtnstyle 不是可选项：SPropertyGrid::CreateChildren 第一行就
                 child("cmdbtnstyle") + SASSERT（SPropertyGrid.cpp:341-342），少了这个
                 节点整个模块直接 abort，不是"少一个按钮"而是白屏退出。控件会在创建时
                 SetVisible(FALSE)，只在就地编辑弹出下拉/对话框时拿来当命令按钮。 -->
            <cmdbtnstyle text="..." skin="_skin.sys.btn.normal"/>
            <editStyle colorBkgnd="#FFFFFF"/>
            <optionStyle colorBkgnd="#FFFFFF"/>
            <groups>
              <propgroup name="窗口" expanded="1">
                <proptext name="标题" value="SOUI on wasm"/>
                <propsize name="尺寸" value="800,600" childrenTitles="宽|高"/>
                <proprect name="位置" value="20,20,820,620" childrenTitles="左|上|右|下" digit="1"/>
              </propgroup>
              <propgroup name="渲染" expanded="1">
                <propoption name="后端" value="canvas2d" options="canvas2d|skia|opengl"/>
                <propoption name="缩放" value="1.0" options="1.0|1.25|1.5"/>
                <proptext name="消息泵" value="swinx PeekMessage" readOnly="1"/>
              </propgroup>
            </groups>
          </propgrid>
        </window>
      </page>

      <!-- HelloChart 页：三个图表控件的构造函数会各自生成一份 dummy 数据，所以
           不接线也有画面；真正要演示的是宿主用模型 API 重建数据 + 动画重放，
          见 soui_main.cpp 的 fillChartDemo / randomizeChartData。 -->
      <page title="图表" layout="vbox" padding="12dp,10dp,12dp,10dp" interval="8dp">
        <text class="h1" size="-2,-1">HelloChart：折线 / 柱状 / 饼图</text>
        <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">controls.extend/hellocharts 用 SLineChartData、SColumnChartData、SPieChartData 建模，由宿主在运行时交给视图；数据对象的所有权随之交给控件，控件析构时释放。</text>
        <window size="-2,-1" layout="hbox" interval="8dp">
          <button name="btn_chart_random" text="换一批数据" skin="_skin.sys.btn.normal" class="body"/>
          <button name="btn_chart_anim" text="重放动画" skin="_skin.sys.btn.normal" class="body"/>
          <text name="chart_status" class="stat" size="0,-1" weight="1"/>
        </window>
        <window size="-2,0" weight="1" layout="hbox" interval="12dp">
          <lineChart name="chart_line" size="0,-2" weight="4" zoomEnabled="0"/>
          <columnChart name="chart_column" size="0,-2" weight="3" zoomEnabled="0"/>
          <pieChart name="chart_pie" size="0,-2" weight="3" zoomEnabled="0"/>
        </window>
      </page>

      <page title="编辑器" layout="vbox" padding="12dp,10dp,12dp,10dp" interval="6dp">
        <text class="h1" size="-2,-1">@string/edit_h1</text>
        <!-- edit_hint / lua_hint 这两个名字是给宿主用的：SOUI_BUILD_WASM_SCINTILLA
             或 SOUI_BUILD_WASM_LUA 关掉时，对应能力没编进来，页面上会留一块安静的
             空白（未注册的标签被布局直接跳过）。noteDisabledFeatures() 会把原因写
             在这两行说明里，而不是让人对着空白猜。 -->
        <text name="edit_hint" class="hint" size="-2,-1" multiLines="1" wordBreak="1">@string/edit_body</text>
        <!-- richedit 的默认字符格式在 SRichEdit::InitDefaultCharFormat 里取
             BeforePaintEx() 之后的 pRT 文字色，不写 colorText 就会继承页签头的中灰。
             autoSel="0"：SEdit 默认 autoSel=1（对标 Win32，聚焦即全选）会让鼠标首击
             变成全选，紧接着打的字把整句替换掉——演示"点进来就能打字"的页面不能要
             这个行为；Tab 进入仍按 re41 的原生语义。 -->
        <edit name="edit_demo" size="-2,40dp" colorText="@color/text" autoSel="0"
              text="点进来就能打字：这一行是 richedit41 静态链入 wasm 的证据" font="size:13dp"/>
        <!-- number="1"（ES_NUMBER）的闸门在 SOUI 侧，不在 richedit41 里：re41 只有
             winresrc.h:1000 那个定义，没有任何检查点。Windows 上 DefWindowProc 会把
             WM_IME_CHAR 转成 WM_CHAR，输入法顺路就走过 OnChar 的数字过滤；swinx 没有
             那步转换，所以非 Windows 平台得由 OnImeChar 自己挡，否则输入法能往数字框里
             塞汉字。 -->
        <window size="-2,-1" layout="hbox" interval="8dp" gravity="center">
          <text class="hint" size="150dp,-1">number="1" 只收数字</text>
          <edit name="edit_num" size="0,40dp" weight="1" number="1" colorText="@color/text"
                text="1234" font="size:13dp"/>
        </window>
        <hexedit name="hex_demo" size="-2,66dp" AutoBytesPerRow="1"
                 AddrBkColor="#F1F5F9" HexBkColor="#FFFFFF" AsciiBkColor="#ECFDF5"/>
        <scintilla name="sci_demo" size="-2,0" weight="1" font="size:13dp" showLineNumber="1"
                   text="// Scintilla on wasm: headless 渲染进 SOUI 的 IRenderTarget&#10;#include &lt;cstdio&gt;&#10;&#10;int main()&#10;{&#10;    for (int i = 0; i &lt; 6; ++i)&#10;    {&#10;        printf(&quot;line %d\n&quot;, i);&#10;    }&#10;    return 0;&#10;}"/>
      </page>

      <page title="扩展控件" layout="vbox" padding="12dp,10dp,12dp,10dp" interval="10dp">
        <text class="h1" size="-2,-1">@string/ext_h1</text>
        <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">@string/ext_body</text>
        <window size="-2,-1" layout="hbox" interval="12dp" gravity="center">
          <text class="hint" size="80dp,-1">colorizeText</text>
          <!-- text 必须写成属性且排在 key 前面。SColorizeText 只在 key 属性生效时
               （OnAttrKey → OnContentChanged → UpdateTextColors）算一次着色区间，
               而标签内联文本是 InitFromXml 在全部属性应用完之后才塞进 m_strText 的，
               排到后面就永远算不出区间、一行都不着色。 -->
          <colorizeText name="clr_demo" size="0,-1" weight="1" class="body"
                        text="在 SOUI 中高亮关键字，用的是 SColorizeText 的 key/colorKey。"
                        colorKey="@color/accent" key="SOUI"/>
        </window>
        <window size="-2,-1" layout="hbox" interval="12dp" gravity="center">
          <text class="hint" size="80dp,-1">水平滚动</text>
          <!-- 宽度故意写死 420dp：文字量出来比控件宽，SScrollText 才会启动水平
               跑马灯；宽度自适应（size="-1"）时会量到刚好装下文字，一像素都不滚。
               rolltype=0 是首尾衔接：滚到末尾后从右侧接上同一段文字。 -->
          <scrolltext name="roll_hoz" size="420dp,24dp" speed="8" class="body">SScrollText 用 SOUI 定时器逐像素推进：这一行明显比它所在的窗口宽，所以文字从右向左循环滚动，滚到末尾再从头接上。</scrolltext>
        </window>
        <window size="-2,-1" layout="hbox" interval="12dp" gravity="center">
          <text class="hint" size="80dp,-1">多行滚动</text>
          <!-- 文本里的 &#10; 是换行符，SScrollText::UpdateScrollInfo 按它拆行；
               拆出多行后走垂直模式：每行停留 staytime 毫秒，然后逐像素向上过渡到
               下一行。行宽没有超过控件宽度，所以停留期不会触发水平展示。 -->
          <scrolltext name="roll_v" size="0,24dp" weight="1" speed="10" staytime="1600" class="body">第一行：SScrollText 按换行符把文本拆成多行，一次只显示一行。&#10;第二行：每行停留 staytime 毫秒，然后逐像素向上滚动到下一行。&#10;第三行：滚到最后一行后回到第一行，继续循环。</scrolltext>
        </window>
      </page>

      <!-- 动画页：SOUI 三种动画形态各占一张卡。
           SAnimation 的目标窗口由宿主的 btn_anim_tween 挂 anim:anim_demo_*（alpha /
           rotate / translate 三段补间），动画播完自动清掉，不残留变换。
           SValueAnimator 只产生值：valueAni:anim_demo_color 与 anim_demo_float 在
           CWasmHostWnd::onAnimationUpdate 里被消费成背景色和进度条数值。
           SPropAnimator 走 Android ObjectAnimator 那套 API：width / alpha /
           colorBkgnd 三个 PropertyValuesHolder 同时推进，布局属性由父容器重排。
           舞台都加 clipClient，平移/旋转/缩放时不会画到旁边卡里。 -->
      <page title="动画" layout="vbox" padding="12dp,10dp,12dp,10dp" interval="8dp">
        <text class="h1" size="-2,-1">@string/anim_h1</text>
        <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">@string/anim_body</text>
        <window size="-2,-1" layout="hbox" interval="8dp">
          <button name="btn_anim_tween" text="SAnimation 补间" skin="_skin.sys.btn.normal" class="body"/>
          <button name="btn_anim_value" text="SValueAnimator 值动画" skin="_skin.sys.btn.normal" class="body"/>
          <button name="btn_anim_prop" text="SPropAnimator 属性动画" skin="_skin.sys.btn.normal" class="body"/>
          <text name="anim_status" class="stat" size="0,-1" weight="1"/>
        </window>
        <window size="-2,0" weight="1" layout="hbox" interval="10dp">
          <window size="0,-2" weight="1" colorBkgnd="@color/surface" layout="vbox"
                  padding="10dp,8dp,10dp,8dp" interval="6dp">
            <text class="h2" size="-2,-1">SAnimation</text>
            <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">XML 补间动画：alpha / rotate / translate</text>
            <window name="tween_stage" size="-2,0" weight="1" colorBkgnd="#EEF2FF"
                    clipClient="1" layout="vbox" gravity="center" interval="8dp">
              <window name="tween_alpha" size="84dp,36dp" colorBkgnd="#4F46E5"
                      layout="vbox" gravity="center">
                <text class="hint" colorText="#FFFFFF">alpha</text>
              </window>
              <window name="tween_rotate" size="84dp,36dp" colorBkgnd="#0EA5E9"
                      layout="vbox" gravity="center">
                <text class="hint" colorText="#FFFFFF">rotate</text>
              </window>
              <window name="tween_translate" size="84dp,36dp" colorBkgnd="#10B981"
                      layout="vbox" gravity="center">
                <text class="hint" colorText="#FFFFFF">translate</text>
              </window>
            </window>
          </window>
          <window size="0,-2" weight="1" colorBkgnd="@color/surface" layout="vbox"
                  padding="10dp,8dp,10dp,8dp" interval="6dp">
            <text class="h2" size="-2,-1">SValueAnimator</text>
            <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">XML 值动画：颜色渐变与浮点进度</text>
            <window name="value_stage" size="-2,0" weight="1" colorBkgnd="#F8FAFC"
                    layout="vbox" padding="10dp,8dp,10dp,8dp" interval="8dp">
              <window name="value_swatch" size="-2,0" weight="1" colorBkgnd="#6366F1"
                      layout="vbox" gravity="center">
                <text class="hint" colorText="#FFFFFF">colorAnimator</text>
              </window>
              <progress name="value_progress" size="-2,14dp" value="0" min="0" max="100"
                        showText="0"/>
              <text name="value_num" class="hint" size="-2,-1">floatAnimator: 0 / 100</text>
            </window>
          </window>
          <window size="0,-2" weight="1" colorBkgnd="@color/surface" layout="vbox"
                  padding="10dp,8dp,10dp,8dp" interval="6dp">
            <text class="h2" size="-2,-1">SPropAnimator</text>
            <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">ObjectAnimator 风格：width / alpha / colorBkgnd 关键帧</text>
            <window name="prop_stage" size="-2,0" weight="1" colorBkgnd="#FFF7ED"
                    layout="vbox" padding="10dp,8dp,10dp,8dp" interval="8dp">
              <window name="prop_box" size="110dp,52dp" colorBkgnd="#F59E0B" clipClient="1"
                      layout="vbox" gravity="center">
                <text class="hint" colorText="#FFFFFF">propBox</text>
              </window>
              <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">布局属性写回 ILayoutParam 后由父容器重排，窗口属性直接改样式；两者都在同一帧里推进。</text>
            </window>
          </window>
        </window>
      </page>

      <page title="Lua 游戏" layout="vbox" padding="8dp,6dp,8dp,6dp" interval="6dp">
        <!-- 这一页原来是"C++ 侧留一个空容器、Lua 在 on_init 里建按钮"的最小样例，
             现在换成 demos/demo 的三个 Lua 游戏（消消乐 / 俄罗斯方块 / 坦克大战）：
             内容由 <include src="layout:XML_PAGE_GAME"/> 从 uires.idx 的 LAYOUT 组
             取页签布局，棋盘格子仍由脚本创建（lua/games.lua 的 *_init）。
             lua_hint 这个名字是给宿主用的：SOUI_BUILD_WASM_LUA=OFF 时脚本工厂没编
             进来，noteDisabledFeatures() 把原因写在这行里，而不是让人对着空白猜。 -->
        <text name="lua_hint" class="hint" size="-2,-1" multiLines="1" wordBreak="1">@string/lua_body</text>
        <include src="layout:XML_PAGE_GAME"/>
      </page>

      <!-- 模态表单页：页内只放一个打开按钮；表单本身是独立资源
           xml/modal_form.xml，由宿主的 btn_modal_open 用
           BeginModalViewSession(L"layout:XML_MODAL_FORM") 建出来。
           wasm 不能走 SHostDialog::DoModal：内层 PeekMessage 拿不到浏览器的新事件，
           所以这里用 SModalRoot + SModalView，把遮罩窗口挂进 SRootWindow，
           用普通的命中测试拦截输入，不需要第二条消息循环。 -->
      <page title="模态表单" layout="vbox" padding="12dp,10dp,12dp,10dp" interval="10dp">
        <text class="h1" size="-2,-1">@string/modal_h1</text>
        <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">@string/modal_body</text>
        <window size="-2,-1" layout="hbox" interval="8dp" gravity="center">
          <button name="btn_modal_open" text="打开表单" skin="_skin.sys.btn.normal" class="body"/>
          <text name="modal_status" class="stat" size="0,-1" weight="1">尚未打开模态表单</text>
        </window>
        <window size="-2,0" weight="1" colorBkgnd="@color/surface" layout="vbox"
                padding="12dp,10dp,12dp,10dp" interval="6dp">
          <text class="h2" size="-2,-1">SModalRoot + SModalView</text>
          <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">弹出层铺满宿主客户区，遮罩是 modalroot 的半透明 colorBkgnd；唯一的子窗口 modalview 负责表单外观与进出场动画。提交 / 取消按钮由宿主订阅 EventCmd，结果经 EndModalViewSession 的 exitCode 从 EventExitModalView 传回主页面。</text>
          <text class="hint" size="-2,-1" multiLines="1" wordBreak="1">SModalRoot 会话由 SHostWnd 的模态栈管理：退场动画完成后，根窗口连同整棵子树被移除并销毁，所以宿主只在这个会话内持有表单控件指针，不额外 AddRef。</text>
        </window>
      </page>
    </tabctrl>
  </root>
</SOUI>
