#include <winres.h>

// Application and system resources are embedded into the exe. main.cpp reads
// both from the current PE module (SetAppResPeHandle/SetSysResPeHandle) when
// ENABLE_BUILD_RESOURCE is defined, so the exe runs as a single file.
#include "res/soui_res.rc2"
#include "theme_sys_res.rc2"


1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SOUI Widgets Gallery - Fluent Design"
            VALUE "ProductName", "SOUIWidgetsGalleryDemo"
            VALUE "OriginalFilename", "SOUIWidgetsGalleryDemo.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
