    <listctrl skin="gallery_card" colorBkgnd="@color/fluent_card_bg" colorText="@color/fluent_text" colorSelText="@color/fluent_text" colorItemBkgnd="@color/fluent_card_bg" colorItemBkgnd2="@color/gallery_subtle" colorItemHotBkgnd="@color/fluent_fill_hover" colorItemSelBkgnd="@color/fluent_fill_pressed" itemSkin="_skin.sys.list.item" checkSkin="_skin.sys.checkbox" sbSkin="_skin.sys.scrollbar" />
