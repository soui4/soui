    <check skin="_skin.sys.checkbox" focusSkin="_skin.sys.focuscheckbox" colorText="@color/fluent_text" />
    <edit skin="fluent_edit" ncSkin="" colorText="@color/fluent_text" padding="6dp,6dp,6dp,6dp" multiLines="0" />
