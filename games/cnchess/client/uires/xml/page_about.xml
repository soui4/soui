    <text name="txt_title" text="开心象棋" colorText="#FFD700" font="size:26;bold:1" align="center" margin="0,0,0,6dp"/>
    <text name="txt_desc" text="使用 SOUI 框架打造的跨平台中国象棋对战游戏，支持在线对战、AI 人机对弈与经典残局打谱。" colorText="#F5E6C8" font="size:13" align="center" margin="0,0,0,4dp"/>
