    <!-- 特色功能介绍 -->
    <text name="txt_new_features" text="玩法特色" colorText="#FFE45E" font="size:16;bold:1" margin="10dp,16dp,5dp,4dp"/>
    <text name="txt_feature_online" text="• 在线对战：大厅选座，与局域网或远程玩家实时对弈" colorText="#E8D9B8" font="size:13" margin="24dp,3dp"/>
    <text name="txt_feature_ai" text="• 人机对弈：大厅选桌邀请机器人，初/中/高三档 AI，机器人入座后自动开局" colorText="#E8D9B8" font="size:13" margin="24dp,3dp"/>
    <text name="txt_feature_endgame" text="• 残局打谱：内置 100 局经典江湖残局，选局邀请机器人陪练，自动进入对局" colorText="#E8D9B8" font="size:13" margin="24dp,3dp"/>
    <text name="txt_feature_fx" text="• 对局体验：吃子/将军/绝杀动画特效与语音播报，支持悔棋、求和、认负" colorText="#E8D9B8" font="size:13" margin="24dp,3dp"/>
    <text name="txt_feature_rule" text="• 规则完备：包含将军、应将、困毙、长捉判负等标准象棋规则" colorText="#E8D9B8" font="size:13" margin="24dp,3dp"/>
    <text name="txt_feature_ui" text="• 主题界面：古风木纹与金色配色，沉浸式对局体验" colorText="#E8D9B8" font="size:13" margin="24dp,3dp"/>
