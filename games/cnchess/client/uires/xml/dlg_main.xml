<?xml version="1.0" encoding="utf-8"?>
<SOUI name="mainWindow" title="@string/title" bigIcon="ICON_LOGO:32" smallIcon="ICON_LOGO:16" margin="5,5,5,5"  resizable="1" wndType="appMain"
appWnd="1"
translucent="1" 
>
  <root skin="skin_main_bg" cache="1"  width="1000" height="800" layout="vbox" padding="10,6,10,10">
    <img size="-2,3" skin="skin_login_gold_line" margin="26,0,26,0"/>
    <caption size="-2,32" layout="hbox" interval="6" gravity="center">
      <icon src="ICON_LOGO:16"/>
      <text text="@string/cnchess" colorText="@color/main_title_hi" font="size:15,bold" letterSpace="2"/>
      <text name="txt_title" colorText="@color/main_title" font="size:12"/>
      <window size="0,0" weight="1"/>
      <window>
        <imgbtn pos="0,0" name="btn_mute" skin="skin_btn_mute" show="0" animate="1" />
        <imgbtn pos="0,0" name="btn_unmute" skin="skin_btn_unmute" animate="1" />
      </window>
      <imgbtn name="btn_min" skin="skin_win_min"  animate="1" />
      <window>
        <imgbtn pos="0,0" name="btn_max" skin="skin_win_max"   animate="1" />
        <imgbtn pos="0,0" name="btn_restore" skin="skin_win_restore"   show="0" animate="1" />
      </window>
      <imgbtn name="btn_close" skin="skin_win_close" tip="close" animate="1"/>
    </caption>
    <window size="-2,0" weight="1" name="content">
      <tabctrl pos="0,0,-0,-0" tabHeight="30" tabWidth="150" tabSkin="skin_tab_header" colorText="#8B7355" colorTextHover="#FFD700" colorTextPush="#FFE45E">
        <include src="layout:page_lobby"/>
        <include src="layout:page_game"/>
        <include src="layout:page_about"/>
      </tabctrl>
      <window pos="0,0,-0,-0" name="tip_container" layout="anchor" float="1" msgTransparent="1"/>
    </window>
  </root>
</SOUI>