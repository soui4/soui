        <text name="txt_title" text="正在更新主题资源..." colorText="#FFD700" font="size:14,bold" gravity="center"/>
        <progress name="progress_bar" bkgndSkin="skin_progress_bg" posSkin="skin_progress_pos" min="0" max="100" value="0" size="-2,16" showText="1"/>
