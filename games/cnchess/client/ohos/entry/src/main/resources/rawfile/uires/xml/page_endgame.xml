<?xml version="1.0" encoding="utf-8"?>
<!-- 残局页签(移动端: 上桌卡列表 + 下预览) 每个残局固定2张游戏桌 -->
<page title="@string/endgame" name="endgame_container" layout="vbox" colorBkgnd="@color/bg_dark">
    <!-- 上部: 残局桌列表(仿普通大厅 tileview) -->
    <window name="wnd_eg_list" size="-2,0" weight="1" layout="vbox" colorBkgnd="@color/bg_panel" padding="8,8,8,8">
        <text text="残局游戏桌" colorText="@color/gold" font="size:13,bold" size="-2,26" gravity="center_vertical"/>
        <tileview name="tileview_endgame" size="-2,0" weight="1" wantTab="1" marginSize="6"
                  sbFadeFrames="30" enableItemDragScroll="1" align="center">
            <template itemWidth="220" itemHeight="180" layout="vbox" gravity="center" skin="skin_item_bk">
                <!-- 顶部: 残局名 + 桌序号 + 对局中 -->
                <window size="-2,30" layout="hbox" interval="5" gravity="center_vertical" padding="10,5,10,0">
                    <text name="txt_eg_table_title" text="" colorText="@color/gold" font="size:12,bold" cursor="hand"/>
                    <text name="txt_eg_table_difficulty" text="" colorText="@color/gold" font="size:11"/>
                    <window size="0,0" weight="1"/>
                    <img name="img_playing" skin="skin_playing" visible="0" size="30,20"/>
                </window>

                <!-- 中间: 座位区域 -->
                <window size="-2,0" weight="1" layout="hbox" interval="5" gravity="center">
                    <window size="0,-1" weight="1" layout="vbox" interval="3" gravity="center">
                        <img name="seat_0" msgTransparent="0" size="50,60" id="10" cursor="hand" skin="skin_seat" iconIndex="0"/>
                        <text name="txt_seat_0" text="红方" colorText="@color/text_light" font="size:10" gravity="center"/>
                    </window>
                    <img skin="skin_table" size="50,40"/>
                    <window size="0,-1" weight="1" layout="vbox" interval="3" gravity="center">
                        <img name="seat_1" msgTransparent="0" size="50,60" id="11" cursor="hand" skin="skin_seat" iconIndex="3"/>
                        <text name="txt_seat_1" text="黑方" colorText="@color/text_light" font="size:10" gravity="center"/>
                    </window>
                </window>

                <!-- 邀请机器人: 点击展开难度(初/中/高 图片按钮) -->
                <window name="wnd_robot_area" size="-2,64" layout="vbox" interval="2" gravity="center" padding="14,2,14,2">
                    <imgbtn name="btn_invite_robot" skin="skin_btn_robot_invite" size="56,28" cursor="hand" animate="1"/>
                    <window name="wnd_robot_levels" size="-2,30" layout="hbox" interval="4" gravity="center" visible="0">
                        <imgbtn name="btn_lvl_beginner" skin="skin_btn_robot_beginner" size="56,28" cursor="hand" animate="1"/>
                        <imgbtn name="btn_lvl_medium" skin="skin_btn_robot_medium" size="56,28" cursor="hand" animate="1"/>
                        <imgbtn name="btn_lvl_advanced" skin="skin_btn_robot_advanced" size="56,28" cursor="hand" animate="1"/>
                    </window>
                </window>

                <!-- 底部: 分隔线和状态提示 -->
                <window size="-2,1" colorBkgnd="@color/divider" opacity="0.3" margin="10,0,10,0"/>
                <window size="-2,25" layout="hbox" interval="5" gravity="center_vertical" padding="10,0,10,5">
                    <text name="txt_status" text="等待入座" colorText="@color/text_muted" font="size:10"/>
                </window>
            </template>
        </tileview>
    </window>

    <!-- 下部: 布局预览 + 详情 -->
    <window name="wnd_eg_detail" size="-2,240" layout="vbox" gravity="center"
            interval="6" padding="10,6,10,6">
        <text name="txt_eg_detail_title" text="残局预览" colorText="@color/gold" font="size:14,bold" gravity="center"/>
        <text name="txt_eg_detail_intro" text="" colorText="@color/text_light" font="size:10" gravity="center"/>
        <chessboard name="chessboard_preview" size="-2,-2" weight="1" enableLayer="1" layout="anchor"/>
    </window>
</page>