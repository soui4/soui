<?xml version="1.0" encoding="utf-8"?>
<page name="room_container" title="@string/about" layout="vbox" colorBkgnd="@color/bg_dark" padding="20">
    <scrollview size="-2,-2" wantTab="1" sbFadeFrames="30" viewSize="-2,-1" layout="vbox" interval="10" padding="20">
        <!-- 标题 -->
        <text name="txt_title" text="象棋游戏" font="size:24,bold" colorText="@color/gold" align="center"/>
        <text name="txt_desc" text="使用 SOUI 框架打造的跨平台中国象棋对战游戏，支持在线对战、AI 人机对弈与经典残局打谱。" font="size:14" colorText="@color/text_light" align="center"/>

        <!-- 分隔线 -->
        <window size="-2,1" colorBkgnd="@color/divider" opacity="0.4" margin="10,5,10,5"/>

        <!-- 玩法特色 -->
        <text name="txt_new_features" text="玩法特色" font="size:16,bold" colorText="@color/gold_light" margin="5,5,5,5"/>
        <text text="• 在线对战：大厅选座，与局域网或远程玩家实时对弈" font="size:14" colorText="@color/text_light" margin="25,5"/>
        <text text="• 人机对弈：大厅选桌邀请机器人，初/中/高三档 AI，机器人入座后自动开局" multiLines="1" font="size:14" colorText="@color/text_light" margin="25,5"/>
        <text text="• 残局打谱：内置 100 局经典江湖残局，选局邀请机器人陪练，自动进入对局" multiLines="1" font="size:14" colorText="@color/text_light" margin="25,5"/>
        <text text="• 对局体验：吃子/将军/绝杀动画特效与语音播报，支持悔棋、求和、认负" multiLines="1" font="size:14" colorText="@color/text_light" margin="25,5"/>
        <text text="• 规则完备：包含将军、应将、困毙、长捉判负等标准象棋规则" font="size:14" colorText="@color/text_light" margin="25,5"/>
        <text text="• 主题界面：古风木纹与金色配色，沉浸式对局体验" font="size:14" colorText="@color/text_light" margin="25,5"/>

        <!-- 分隔线 -->
        <window size="-2,1" colorBkgnd="@color/divider" opacity="0.4" margin="10,10,10,5"/>

        <!-- 联系方式 -->
        <text name="txt_contact" text="联系我们：" font="size:16,bold" colorText="@color/gold_light" margin="5,5,5,5"/>
        <text name="txt_qq_group" text="SOUI官方QQ群：229313785" font="size:14" colorText="@color/text_light" margin="15,5"/>
        <text name="txt_website" text="官方网站：https://soui.com.cn/cnchess" font="size:14" colorText="@color/text_light" margin="15,5"/>

        <!-- 底部信息 -->
        <window size="-2,1" colorBkgnd="@color/divider" opacity="0.4" margin="10,15,10,5"/>
        <text name="txt_info" text="SOUI是一套轻量级的Windows客户端UI开发框架，具有高效、稳定、易用的特点。如果您对此项目感兴趣，欢迎加入我们的QQ群交流学习！" font="size:12" colorText="@color/text_muted" align="center" margin="10,5"/>
        <text name="txt_thanks" text="所有游戏图片资源来自网络，版权归原作者所有。" font="size:12" colorText="@color/text_muted" align="center" margin="10,5"/>
        <text name="txt_copyright" text="Copyright © 2015-2026 Setoutsoft" font="size:12" colorText="@color/text_muted" align="center"/>
    </scrollview>
</page>
